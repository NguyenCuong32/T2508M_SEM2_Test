@model List<ComicBook>
@{ ViewData["Title"] = "Quản lý truyện"; }

<div class="page-heading">
    <h1>Quản lý truyện</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm truyện</a>
</div>
<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light"><tr><th>Mã</th><th>Tên truyện</th><th>Tác giả</th><th class="text-end">Giá thuê/ngày (VNĐ)</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.ComicBookId</td><td>@book.Title</td><td>@book.Author</td>
                <td class="text-end">@book.PricePerDay.ToString("#,##0.##")</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@book.ComicBookId" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@book.ComicBookId" method="post" class="d-inline" onsubmit="return confirm('Bạn muốn xóa truyện này?');">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-muted">Chưa có truyện. Hãy thêm truyện đầu tiên.</td></tr>
        }
        </tbody>
    </table>
</div>

@model ReportViewModel
@{ ViewData["Title"] = "Báo cáo thuê truyện"; }

<h1>Báo cáo thuê truyện</h1>
<p class="text-muted">Liệt kê truyện có ngày thuê nằm trong khoảng đã chọn.</p>
<form asp-action="Report" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-sm-4 col-md-3">
        <label asp-for="StartDate" class="form-label">Từ ngày</label>
        <input asp-for="StartDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" required />
    </div>
    <div class="col-sm-4 col-md-3">
        <label asp-for="EndDate" class="form-label">Đến ngày</label>
        <input asp-for="EndDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" required />
    </div>
    <div class="col-sm-4"><button type="submit" class="btn btn-primary">Xem báo cáo</button></div>
</form>
<div asp-validation-summary="All" class="text-danger"></div>
@if (ViewData.ModelState.IsValid)
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="table-light"><tr><th>STT</th><th>Tên truyện</th><th>Ngày thuê</th><th>Ngày trả</th><th>Khách hàng</th><th class="text-end">Số lượng</th></tr></thead>
            <tbody>
            @for (var i = 0; i < Model.Rows.Count; i++)
            {
                var row = Model.Rows[i];
                <tr><td>@(i + 1)</td><td>@row.BookName</td><td>@row.RentalDate.ToString("dd/MM/yyyy")</td><td>@row.ReturnDate.ToString("dd/MM/yyyy")</td><td>@row.CustomerName</td><td class="text-end">@row.Quantity</td></tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted">Không có lượt thuê trong khoảng ngày này.</td></tr>
            }
            </tbody>
        </table>
    </div>
}

@model List<Rental>
@{ ViewData["Title"] = "Phiếu thuê"; }

<div class="page-heading">
    <h1>Phiếu thuê</h1>
    <a asp-action="Create" class="btn btn-primary">Tạo phiếu thuê</a>
</div>
<div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead class="table-light"><tr><th>Mã phiếu</th><th>Khách hàng</th><th>Ngày thuê</th><th>Ngày trả</th><th>Truyện thuê</th><th>Trạng thái</th></tr></thead>
        <tbody>
        @foreach (var rental in Model)
        {
            <tr>
                <td>@rental.RentalId</td><td>@rental.Customer.FullName</td>
                <td class="text-nowrap">@rental.RentalDate.ToString("dd/MM/yyyy")</td>
                <td class="text-nowrap">@rental.ReturnDate.ToString("dd/MM/yyyy")</td>
                <td>
                    @foreach (var item in rental.RentalDetails)
                    {
                        <div>@item.ComicBook.Title — SL: @item.Quantity, @item.PricePerDay.ToString("#,##0.##") VNĐ/ngày</div>
                    }
                </td>
                <td>@(rental.Status == "Renting" ? "Đang thuê" : rental.Status == "Returned" ? "Đã trả" : rental.Status)</td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted">Chưa có phiếu thuê.</td></tr>
        }
        </tbody>
    </table>
</div>

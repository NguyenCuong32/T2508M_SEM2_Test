@model ComicSystem.Models.Customer

@{
    ViewData["Title"] = "Đăng ký Khách hàng";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0"><i class="bi bi-person-plus me-2"></i>Đăng ký Khách hàng mới (Customer Register)</h4>
            </div>
            <div class="card-body">
                <form asp-action="Register">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên khách hàng..." />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-bold"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại..." />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RegisterDate" class="form-label fw-bold"></label>
                        <input asp-for="RegisterDate" class="form-control" type="date" value="@Model.RegisterDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="RegisterDate" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-3">
                        <a asp-action="Index" class="btn btn-secondary">Xem danh sách KH</a>
                        <button type="submit" class="btn btn-success">Đăng ký mới</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

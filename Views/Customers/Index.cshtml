@model IEnumerable<ComicSystem.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 pt-2">
    <div>
        <h2 class="fw-bold mb-1 d-flex align-items-center gap-2" style="color: #2d3748;">
            <i class="bi bi-people" style="color: #3e8e7e;"></i> Customers
        </h2>
        <div class="text-muted" style="font-size: 0.95rem;">Manage registered customers</div>
    </div>
    <a asp-action="Register" class="btn-add-new">
        <i class="bi bi-person-plus"></i> Register Customer
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Table -->
<div class="table-responsive shadow-sm" style="border-radius: 4px; overflow: hidden; background: #ffffff;">
    <table class="table table-comic mb-0">
        <thead>
            <tr>
                <th style="width: 60px;">#</th>
                <th>FULL NAME</th>
                <th>PHONE NUMBER</th>
                <th>REGISTER DATE</th>
                <th class="text-center" style="width: 250px;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@(index++)</td>
                        <td>
                            <strong style="color: #1a202c;">@item.FullName</strong>
                        </td>
                        <td style="color: #4a5568;">@item.PhoneNumber</td>
                        <td>@item.RegistrationDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.CustomerID" class="btn-action-view">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.CustomerID" class="btn-action-edit">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-controller="Rentals" asp-action="Create" asp-route-customerId="@item.CustomerID" class="btn-action-view" style="background-color: #3e8e7e;">
                                    <i class="bi bi-cart"></i> Rent
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-5 text-muted">
                        No customers found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

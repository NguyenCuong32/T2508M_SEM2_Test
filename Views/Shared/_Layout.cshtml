<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ComicSystem</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="app-body">

    <!-- Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">

                    <i class="bi bi-book-half me-2"></i>
                    ComicSystem
                </a>

                <!-- Mobile toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Menu -->
                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">

                                <i class="bi bi-house-door me-1"></i>
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ComicBooks" ? "active" : "")"
                               asp-controller="ComicBooks" asp-action="Index">

                                <i class="bi bi-book me-1"></i>
                                Comic Books
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")"
                               asp-controller="Customers" asp-action="Index">

                                <i class="bi bi-people me-1"></i>
                                Customers
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rentals" ? "active" : "")"
                               asp-controller="Rentals" asp-action="Index">

                                <i class="bi bi-cart-check me-1"></i>
                                Rentals
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
                               asp-controller="Reports" asp-action="Index">

                                <i class="bi bi-bar-chart-line me-1"></i>
                                Reports
                            </a>
                        </li>

                    </ul>

                    <div class="d-flex align-items-center text-white">
                        <i class="bi bi-person-circle fs-5 me-2"></i>
                        <span class="small">Admin</span>
                    </div>

                </div>

            </div>
        </nav>
    </header>

    <!-- Main -->
    <main class="container py-4">

        @RenderBody()

    </main>

    <!-- Footer -->
    <footer class="app-footer">
        <div class="container">

            <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-2">

                <span>
                    <i class="bi bi-book-half me-1"></i>
                    ComicSystem
                </span>

                <span class="text-muted">
                    ASP.NET Core MVC
                </span>

            </div>

        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
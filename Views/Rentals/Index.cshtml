@model IEnumerable<ComicSystem.Models.Rental>

@{
    ViewData["Title"] = "Rentals";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 pt-2">
    <div>
        <h2 class="fw-bold mb-1 d-flex align-items-center gap-2" style="color: #2d3748;">
            <i class="bi bi-cart" style="color: #3e8e7e;"></i> Rentals
        </h2>
        <div class="text-muted" style="font-size: 0.95rem;">Manage rental orders and details</div>
    </div>
    <a asp-action="Create" class="btn-add-new">
        <i class="bi bi-plus-circle"></i> New Rental
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Table -->
<div class="table-responsive shadow-sm" style="border-radius: 4px; overflow: hidden; background: #ffffff;">
    <table class="table table-comic mb-0">
        <thead>
            <tr>
                <th style="width: 60px;">#</th>
                <th>CUSTOMER</th>
                <th>COMIC BOOKS</th>
                <th>RENTAL DATE</th>
                <th>RETURN DATE</th>
                <th>STATUS</th>
                <th class="text-center" style="width: 200px;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@(index++)</td>
                        <td>
                            <strong style="color: #1a202c;">@item.Customer?.FullName</strong>
                            <div class="text-muted small">@item.Customer?.PhoneNumber</div>
                        </td>
                        <td>
                            @foreach (var rd in item.RentalDetails)
                            {
                                <div>
                                    <strong>@rd.ComicBook?.Title</strong>
                                    <span class="text-muted">(Qty: @rd.Quantity)</span>
                                </div>
                            }
                        </td>
                        <td>@item.RentalDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.ReturnDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge" style="background-color: @(item.Status == "Đang thuê" ? "#ed8936" : "#48bb78"); font-size: 0.8rem; padding: 5px 10px;">
                                @item.Status
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.RentalID" class="btn-action-view">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                @if (item.Status == "Đang thuê")
                                {
                                    <form asp-action="ReturnRental" asp-route-id="@item.RentalID" method="post" class="d-inline" onsubmit="return confirm('Confirm return books?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-action-edit" style="background-color: #38a169;">
                                            <i class="bi bi-check2"></i> Return
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center py-5 text-muted">
                        No rentals found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

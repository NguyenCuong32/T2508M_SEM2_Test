@model IEnumerable<ComicSystem.Models.Rental>

@{
    ViewData["Title"] = "Lịch sử cho thuê truyện";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-text me-2"></i>Danh sách phiếu thuê truyện (Rentals & Details)</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Cho thuê truyện mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 70px;">Mã</th>
                        <th>Tên khách hàng</th>
                        <th>Truyện đã thuê</th>
                        <th>Ngày thuê</th>
                        <th>Ngày trả</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Đơn giá / ngày</th>
                        <th class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">Chưa có thông tin thuê truyện nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model) {
                        var detail = item.RentalDetails?.FirstOrDefault();
                        <tr>
                            <td>#@item.RentalID</td>
                            <td class="fw-bold">@(item.Customer?.FullName ?? "N/A")</td>
                            <td class="text-primary fw-bold">@(detail?.ComicBook?.Title ?? "N/A")</td>
                            <td>@item.RentalDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.ReturnDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center fw-bold">@(detail?.Quantity ?? 0)</td>
                            <td class="text-end">@((detail?.PricePerDay ?? 0).ToString("N0")) VNĐ</td>
                            <td class="text-center">
                                <span class="badge bg-warning text-dark">@item.Status</span>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

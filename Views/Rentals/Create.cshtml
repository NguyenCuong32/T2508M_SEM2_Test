@model T2508M_SEM_Test.DTOs.Rentals.RentalCreateDto

@{
    ViewData["Title"] = "Create Rental";
}

<h1>Create Rental</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="CustomerId"
                       class="form-label">
                    Customer
                </label>

                <select asp-for="CustomerId"
                        asp-items="ViewBag.Customers"
                        class="form-select">
                    <option value="">-- Select Customer --</option>
                </select>

                <span asp-validation-for="CustomerId"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="ComicBookId"
                       class="form-label">
                    Comic Book
                </label>

                <select asp-for="ComicBookId"
                        asp-items="ViewBag.ComicBooks"
                        class="form-select">
                    <option value="">-- Select Comic Book --</option>
                </select>

                <span asp-validation-for="ComicBookId"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="RentalDate"
                       class="form-label">
                    Rental Date
                </label>

                <input asp-for="RentalDate"
                       type="datetime-local"
                       class="form-control" />

                <span asp-validation-for="RentalDate"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="ReturnDate"
                       class="form-label">
                    Return Date
                </label>

                <input asp-for="ReturnDate"
                       type="datetime-local"
                       class="form-control" />

                <span asp-validation-for="ReturnDate"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity"
                       class="form-label">
                    Quantity
                </label>

                <input asp-for="Quantity"
                       type="number"
                       min="1"
                       max="999"
                       class="form-control" />

                <span asp-validation-for="Quantity"
                      class="text-danger">
                </span>
            </div>

            <div class="alert alert-info">
                Price per day will be taken automatically
                from the selected comic book.
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Rent Book
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@model ComicSystem.ViewModels.RentalCreateViewModel

@{
    ViewData["Title"] = "Tạo phiếu thuê truyện";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-journal-plus me-2"></i>Tạo phiếu cho thuê truyện (Rental Page)</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Customer Selection -->
                    <div class="mb-3">
                        <label asp-for="CustomerID" class="form-label fw-bold"></label>
                        <select asp-for="CustomerID" class="form-select" asp-items="ViewBag.CustomerID">
                            <option value="">-- Chọn khách hàng --</option>
                        </select>
                        <span asp-validation-for="CustomerID" class="text-danger"></span>
                    </div>

                    <!-- ComicBook Selection -->
                    <div class="mb-3">
                        <label asp-for="ComicBookID" class="form-label fw-bold"></label>
                        <select asp-for="ComicBookID" class="form-select" id="comicBookSelect" asp-items="ViewBag.ComicBookID">
                            <option value="">-- Chọn truyện tranh --</option>
                        </select>
                        <span asp-validation-for="ComicBookID" class="text-danger"></span>
                    </div>

                    <!-- Rental Date & Return Date -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="RentalDate" class="form-label fw-bold"></label>
                            <input asp-for="RentalDate" class="form-control" type="date" value="@Model.RentalDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="RentalDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ReturnDate" class="form-label fw-bold"></label>
                            <input asp-for="ReturnDate" class="form-control" type="date" value="@Model.ReturnDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="ReturnDate" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Quantity & PricePerDay -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Quantity" class="form-label fw-bold"></label>
                            <input asp-for="Quantity" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PricePerDay" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <input asp-for="PricePerDay" class="form-control" id="pricePerDayInput" type="number" step="500" placeholder="Tự động theo truyện..." />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <span asp-validation-for="PricePerDay" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-3">
                        <a asp-action="Index" class="btn btn-secondary">Xem danh sách cho thuê</a>
                        <button type="submit" class="btn btn-primary">Xác nhận cho thuê</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('comicBookSelect').addEventListener('change', function() {
            var bookId = this.value;
            if (bookId) {
                fetch('/Rentals/GetBookPrice/' + bookId)
                    .then(response => response.json())
                    .then(data => {
                        if (data && data.price !== undefined) {
                            document.getElementById('pricePerDayInput').value = data.price;
                        }
                    })
                    .catch(err => console.error(err));
            }
        });
    </script>
}

@model ComicSystem.Models.ViewModels.RentalCreateViewModel

@{
    ViewData["Title"] = "New Rental";
}

<div class="row justify-content-center pt-3">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm" style="border-radius: 6px; background: #ffffff;">
            <div class="card-header py-3" style="background-color: #3e8e7e; color: #ffffff; border-top-left-radius: 6px; border-top-right-radius: 6px;">
                <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-cart-plus"></i> New Book Rental
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CustomerID" class="form-label fw-semibold" style="font-size: 0.9rem;">Customer</label>
                        <select asp-for="CustomerID" class="form-select" asp-items="Model.CustomersList"></select>
                        <span asp-validation-for="CustomerID" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ComicBookID" class="form-label fw-semibold" style="font-size: 0.9rem;">Comic Book</label>
                        <select asp-for="ComicBookID" class="form-select" asp-items="Model.ComicBooksList" id="bookSelect"></select>
                        <span asp-validation-for="ComicBookID" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="RentalDate" class="form-label fw-semibold" style="font-size: 0.9rem;">Rental Date</label>
                            <input asp-for="RentalDate" class="form-control" type="date" id="rentalDateInput" />
                            <span asp-validation-for="RentalDate" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label asp-for="ReturnDate" class="form-label fw-semibold" style="font-size: 0.9rem;">Return Date</label>
                            <input asp-for="ReturnDate" class="form-control" type="date" id="returnDateInput" />
                            <span asp-validation-for="ReturnDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="Quantity" class="form-label fw-semibold" style="font-size: 0.9rem;">Quantity</label>
                            <input asp-for="Quantity" class="form-control" type="number" min="1" max="50" id="quantityInput" />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label asp-for="PricePerDay" class="form-label fw-semibold" style="font-size: 0.9rem;">Price per Day</label>
                            <input asp-for="PricePerDay" class="form-control" type="number" step="0.5" min="0.5" id="priceInput" />
                            <span asp-validation-for="PricePerDay" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-semibold" style="font-size: 0.9rem;">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Đang thuê">Đang thuê</option>
                            <option value="Có thể thuê">Có thể thuê</option>
                            <option value="Đã trả">Đã trả</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 6px;">Cancel</a>
                        <button type="submit" class="btn-add-new" style="border-radius: 6px; padding: 8px 24px;">
                            Complete Rental
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const bookSelect = document.getElementById('bookSelect');
            const priceInput = document.getElementById('priceInput');

            function updatePriceFromBook() {
                const bookId = bookSelect.value;
                if (!bookId) return;

                fetch(`/Rentals/GetBookPrice?id=${bookId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data && data.price) {
                            priceInput.value = data.price;
                        }
                    })
                    .catch(err => console.error(err));
            }

            bookSelect.addEventListener('change', updatePriceFromBook);
        });
    </script>
}

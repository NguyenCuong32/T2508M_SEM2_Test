@model ComicSystem.ViewModels.ReportFilterViewModel

@{
    ViewData["Title"] = "Báo cáo thuê sách";
}

<div class="mb-4">
    <h2><i class="bi bi-file-earmark-bar-graph me-2"></i>Báo cáo thuê sách (Report All Book Rents)</h2>
    <p class="text-muted">Báo cáo danh sách sách đã cho thuê theo khoảng thời gian từ Ngày bắt đầu (Start date) đến Ngày kết thúc (End date).</p>
</div>

<!-- Date Filter Form -->
<div class="card shadow-sm mb-4">
    <div class="card-body bg-light">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label asp-for="StartDate" class="form-label fw-bold"></label>
                <input asp-for="StartDate" class="form-control" type="date" value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : "")" />
            </div>

            <div class="col-md-4">
                <label asp-for="EndDate" class="form-label fw-bold"></label>
                <input asp-for="EndDate" class="form-control" type="date" value="@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "")" />
            </div>

            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    Lọc báo cáo
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Đặt lại
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Report Table matching exam paper exactly -->
<div class="card shadow-sm">
    <div class="card-header bg-dark text-white fw-bold">
        Danh sách cho thuê truyện
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead class="table-light text-center fw-bold">
                    <tr>
                        <th style="width: 60px;">No</th>
                        <th>Book name</th>
                        <th style="width: 140px;">Rental date</th>
                        <th style="width: 140px;">Return date</th>
                        <th>Customer name</th>
                        <th style="width: 100px;">Quantity</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Reports.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Không tìm thấy dữ liệu báo cáo trong khoảng thời gian đã chọn.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Reports)
                    {
                        <tr>
                            <td class="text-center fw-bold">@item.No</td>
                            <td>@item.BookName</td>
                            <td class="text-center">@item.RentalDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@item.ReturnDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.CustomerName</td>
                            <td class="text-center fw-bold">@item.Quantity</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model ComicSystem.Models.ViewModels.RentalReportViewModel

@{
    ViewData["Title"] = "Reports";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 pt-2">
    <div>
        <h2 class="fw-bold mb-1 d-flex align-items-center gap-2" style="color: #2d3748;">
            <i class="bi bi-graph-up" style="color: #3e8e7e;"></i> Reports
        </h2>
        <div class="text-muted" style="font-size: 0.95rem;">All book rents between start date to end date</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" 
           asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")" 
           asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")" 
           class="btn-action-view" style="background-color: #38a169; padding: 8px 14px; border-radius: 6px;">
            <i class="bi bi-file-earmark-excel"></i> Export CSV
        </a>
        <button onclick="window.print();" class="btn-action-view" style="background-color: #2b4c6f; padding: 8px 14px; border-radius: 6px;">
            <i class="bi bi-printer"></i> Print
        </button>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 6px; background-color: #ffffff;">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light">Start date</span>
                    <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light">End date</span>
                    <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-add-new" style="padding: 6px 14px;">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" style="border-radius: 6px;">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Table strictly matching Question 4 -->
<div class="table-responsive shadow-sm" style="border-radius: 4px; overflow: hidden; background: #ffffff;">
    <table class="table table-comic mb-0">
        <thead>
            <tr>
                <th style="width: 60px;">NO</th>
                <th>BOOK NAME</th>
                <th>RENTAL DATE</th>
                <th>RETURN DATE</th>
                <th>CUSTOMER NAME</th>
                <th class="text-center" style="width: 120px;">QUANTITY</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ReportItems != null && Model.ReportItems.Any())
            {
                foreach (var item in Model.ReportItems)
                {
                    <tr>
                        <td class="fw-bold">@item.No</td>
                        <td>
                            <strong style="color: #1a202c;">@item.BookName</strong>
                        </td>
                        <td>@item.RentalDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.ReturnDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.CustomerName</td>
                        <td class="text-center">
                            <span class="badge-price" style="background-color: #2b4c6f;">
                                @item.Quantity
                            </span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        No records found in this date range.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

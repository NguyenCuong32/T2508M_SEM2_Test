@model IEnumerable<BookStore.Models.Rental>
@{
    ViewData["Title"] = "Rental";
}

<div class="container-mt4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Rental</h1>
        <a asp-action="Create" class="btn btn-primary">Create New Rental</a>
</div>

<table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Rental ID</th>
                <th>Customer Name</th>
                <th>Comic Book Title</th>
                <th>Rental Date</th>
                <th>Return Date</th>
                <th>Quantity</th>
                <th>Status</th>
            </tr>
         </thead>
         <tbody>
            foreach (var item in Model)
            {
            <tr>
                <td>@rental.Customer.FullName</td>
                <td>@detail.ComicBook.Title</td>
                <td>@rental.RentalDate.ToString("MM/dd/yyyy")</td>
                <td>@rental.ReturnDate.ToString("MM/dd/yyyy"))</td>
                <td>@detail.Quantity</td>
                <td>@rental.Status</td>>
            </tr>
            }
         </tbody>
</table>
</div>
@model IEnumerable<ComicSystem.Models.ComicBook>

@{
    ViewData["Title"] = "Quản lý truyện tranh";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-book me-2"></i>Danh sách truyện tranh (Comic Books)</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Thêm truyện mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>@Html.DisplayNameFor(model => model.Title)</th>
                        <th>@Html.DisplayNameFor(model => model.Author)</th>
                        <th>@Html.DisplayNameFor(model => model.PricePerDay)</th>
                        <th style="width: 200px;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Chưa có truyện nào trong hệ thống.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model) {
                        <tr>
                            <td>@item.ComicBookID</td>
                            <td class="fw-bold">@item.Title</td>
                            <td>@item.Author</td>
                            <td>@item.PricePerDay.ToString("N0") VNĐ</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.ComicBookID" class="btn btn-outline-warning" title="Sửa">
                                        Sửa
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.ComicBookID" class="btn btn-outline-info" title="Chi tiết">
                                        Chi tiết
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ComicBookID" class="btn btn-outline-danger" title="Xóa">
                                        Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

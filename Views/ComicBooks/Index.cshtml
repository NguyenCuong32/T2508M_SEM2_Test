@model IEnumerable<ComicSystem.Models.ComicBook>

@{
    ViewData["Title"] = "Comic Books";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 pt-2">
    <div>
        <h2 class="fw-bold mb-1 d-flex align-items-center gap-2" style="color: #2d3748;">
            <i class="bi bi-journal-text" style="color: #3e8e7e;"></i> Comic Books
        </h2>
        <div class="text-muted" style="font-size: 0.95rem;">Manage your comic book collection</div>
    </div>
    <a asp-action="Create" class="btn-add-new">
        <i class="bi bi-plus-circle"></i> Add New
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Table matching screenshot exactly -->
<div class="table-responsive shadow-sm" style="border-radius: 4px; overflow: hidden; background: #ffffff;">
    <table class="table table-comic mb-0">
        <thead>
            <tr>
                <th style="width: 60px;">#</th>
                <th>TITLE</th>
                <th>AUTHOR</th>
                <th>PRICE/DAY</th>
                <th class="text-center" style="width: 250px;">ACTIONS</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@(index++)</td>
                        <td>
                            <strong style="color: #1a202c;">@item.Title</strong>
                        </td>
                        <td style="color: #4a5568;">@item.Author</td>
                        <td>
                            <span class="badge-price">
                                @(item.PricePerDay >= 100 ? string.Format("{0:N0} đ", item.PricePerDay) : string.Format("${0:F2}", item.PricePerDay))
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.ComicBookID" class="btn-action-view">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.ComicBookID" class="btn-action-edit">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ComicBookID" class="btn-action-delete">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-5 text-muted">
                        No comic books found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model T2508M_SEM_Test.Models.Comicbook

@{
    ViewData["Title"] = "Delete Comic Book";
}

<h1>Delete Comic Book</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this comic book?
</div>

<dl class="row">

    <dt class="col-sm-3">
        ID
    </dt>
    <dd class="col-sm-9">
        @Model.ComicBookId
    </dd>

    <dt class="col-sm-3">
        Title
    </dt>
    <dd class="col-sm-9">
        @Model.Title
    </dd>

    <dt class="col-sm-3">
        Author
    </dt>
    <dd class="col-sm-9">
        @Model.Author
    </dd>

    <dt class="col-sm-3">
        Price Per Day
    </dt>
    <dd class="col-sm-9">
        @Model.PricePerDay.ToString("N2")
    </dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden"
           name="id"
           value="@Model.ComicBookId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
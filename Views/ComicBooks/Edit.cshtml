@model ComicSystem.Models.ComicBook

@{
    ViewData["Title"] = "Edit Comic Book";
}

<div class="row justify-content-center pt-3">
    <div class="col-md-7 col-lg-5">
        <div class="card border-0 shadow-sm" style="border-radius: 6px; background: #ffffff;">
            <div class="card-header py-3" style="background-color: #ed8936; color: #ffffff; border-top-left-radius: 6px; border-top-right-radius: 6px;">
                <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-pencil"></i> Edit Comic Book
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="ComicBookID" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold" style="font-size: 0.9rem;">Title</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Author" class="form-label fw-semibold" style="font-size: 0.9rem;">Author</label>
                        <input asp-for="Author" class="form-control" />
                        <span asp-validation-for="Author" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PricePerDay" class="form-label fw-semibold" style="font-size: 0.9rem;">Price per Day</label>
                        <input asp-for="PricePerDay" class="form-control" type="number" step="0.5" min="0.5" />
                        <span asp-validation-for="PricePerDay" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 6px;">Cancel</a>
                        <button type="submit" class="btn-action-edit" style="border-radius: 6px; padding: 8px 24px;">
                            Update
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

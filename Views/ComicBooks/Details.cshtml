@model ComicSystem.Models.ComicBook

@{
    ViewData["Title"] = "Chi tiết truyện - " + Model.Title;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow border-0 mb-4">
            <div class="card-header bg-info text-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Chi Tiết Truyện Tranh</h4>
                <span class="badge bg-light text-dark fs-6">ID: #@Model.ComicBookID</span>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Tên sách (Title):</div>
                    <div class="col-sm-8 fw-bold fs-5 text-dark">@Model.Title</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Tác giả (Author):</div>
                    <div class="col-sm-8">@Model.Author</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Giá thuê 1 ngày (PricePerDay):</div>
                    <div class="col-sm-8 text-success fw-bold fs-5">@string.Format("{0:N0} VNĐ", Model.PricePerDay)</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Tổng lượt đã thuê:</div>
                    <div class="col-sm-8">
                        <span class="badge bg-primary">@(Model.RentalDetails?.Count ?? 0) lượt thuê</span>
                    </div>
                </div>

                <hr />

                <h5 class="fw-bold mb-3 text-secondary"><i class="bi bi-clock-history me-2"></i>Lịch Sử Thuê Truyện Này</h5>
                @if (Model.RentalDetails != null && Model.RentalDetails.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã phiếu</th>
                                    <th>Khách hàng</th>
                                    <th>Ngày thuê</th>
                                    <th>Ngày trả</th>
                                    <th>Số lượng</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rd in Model.RentalDetails)
                                {
                                    <tr>
                                        <td>#@rd.RentalID</td>
                                        <td>@rd.Rental?.Customer?.FullName</td>
                                        <td>@rd.Rental?.RentalDate.ToString("dd/MM/yyyy")</td>
                                        <td>@rd.Rental?.ReturnDate.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge bg-secondary">@rd.Quantity</span></td>
                                        <td>
                                            <span class="badge @(rd.Rental?.Status == "Đang thuê" ? "bg-warning text-dark" : "bg-success")">
                                                @rd.Rental?.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted fst-italic">Chưa có lượt thuê nào cho truyện này.</p>
                }

                <div class="d-flex justify-content-between pt-3 border-top mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                    <div class="gap-2 d-flex">
                        <a asp-action="Edit" asp-route-id="@Model.ComicBookID" class="btn btn-warning">
                            <i class="bi bi-pencil me-1"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.ComicBookID" class="btn btn-outline-danger">
                            <i class="bi bi-trash me-1"></i> Xóa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

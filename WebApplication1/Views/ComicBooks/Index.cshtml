@model IEnumerable<WebApplication1.Models.ComicBook>

@{
    ViewData["Title"] = "Quản lý truyện tranh (Question 1)";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="badge bg-primary mb-2">Question 1: 3 điểm</div>
        <h2 class="fw-bold mb-0">Quản Lý Truyện Tranh (ComicBooks)</h2>
        <p class="text-muted small mb-0">Thêm, xem danh sách, cập nhật và xoá truyện tranh trong hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Thêm truyện mới
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-start-0" placeholder="Tìm kiếm theo tên truyện (Title) hoặc tác giả (Author)..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100 rounded-pill">Tìm kiếm</button>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Hủy</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover table-custom mb-0">
            <thead>
                <tr>
                    <th style="width: 80px;">Mã</th>
                    <th>Tên truyện (Title)</th>
                    <th>Tác giả (Author)</th>
                    <th>Giá thuê / ngày (PricePerDay)</th>
                    <th class="text-end" style="width: 280px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                            Không tìm thấy truyện tranh nào. Hãy thêm truyện mới!
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-secondary">#@item.ComicBookID</td>
                            <td>
                                <div class="fw-bold text-dark fs-6">@item.Title</div>
                            </td>
                            <td>
                                <span class="text-muted">@(string.IsNullOrWhiteSpace(item.Author) ? "Chưa cập nhật" : item.Author)</span>
                            </td>
                            <td>
                                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-2 fs-6">
                                    @item.PricePerDay.ToString("N0") đ/ngày
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.ComicBookID" class="btn btn-outline-primary" title="Sửa">
                                        <i class="bi bi-pencil-square me-1"></i> Sửa
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.ComicBookID" class="btn btn-outline-info" title="Chi tiết">
                                        <i class="bi bi-eye me-1"></i> Chi tiết
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ComicBookID" class="btn btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash me-1"></i> Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@model WebApplication1.Models.ComicBook

@{
    ViewData["Title"] = "Xóa truyện tranh: " + Model.Title;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm border-top border-danger border-4">
            <div class="card-header bg-white py-3">
                <div class="badge bg-danger mb-1">Question 1: Delete</div>
                <h4 class="mb-0 fw-bold text-danger"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Xác Nhận Xóa Truyện</h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i> Bạn có chắc chắn muốn xóa cuốn truyện tranh này khỏi hệ thống không?
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Mã truyện:</dt>
                    <dd class="col-sm-8 fw-semibold">#@Model.ComicBookID</dd>

                    <dt class="col-sm-4 text-muted">Tên truyện:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Title</dd>

                    <dt class="col-sm-4 text-muted">Tác giả:</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Author) ? "Chưa rõ" : Model.Author)</dd>

                    <dt class="col-sm-4 text-muted">Giá thuê / ngày:</dt>
                    <dd class="col-sm-8 text-success fw-bold">@Model.PricePerDay.ToString("N0") đ/ngày</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="ComicBookID" />
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-arrow-left me-1"></i> Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                            <i class="bi bi-trash me-1"></i> Xóa vĩnh viễn
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

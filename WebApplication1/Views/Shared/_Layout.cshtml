<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - comicsys.com | Hệ Thống Thuê Truyện Tranh</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top custom-navbar shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-book-half"></i></span>
                <span>comicsys<span class="text-warning">.com</span></span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i> Trang chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="ComicBooks" asp-action="Index">
                            <i class="bi bi-journal-text me-1"></i> Truyện tranh (Q1)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customers" asp-action="Index">
                            <i class="bi bi-people me-1"></i> Khách hàng (Q2)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Rentals" asp-action="Create">
                            <i class="bi bi-cart-plus me-1"></i> Thuê truyện (Q3)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Rentals" asp-action="Report">
                            <i class="bi bi-bar-chart-line me-1"></i> Báo cáo thuê sách (Q4)
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Rentals" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-clock-history me-1"></i> Lịch sử thuê
                    </a>
                    <a asp-controller="Rentals" asp-action="Create" class="btn btn-warning btn-sm rounded-pill fw-semibold px-3 text-dark">
                        <i class="bi bi-plus-circle me-1"></i> Thuê ngay
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <main class="py-4 min-vh-80">
        <div class="container">
            <!-- Toast / Flash messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 border-start border-success border-4 mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
                        <div>
                            <strong>Thành công!</strong> @TempData["SuccessMessage"]
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 border-start border-danger border-4 mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-4 me-3"></i>
                        <div>
                            <strong>Lỗi!</strong> @TempData["ErrorMessage"]
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto py-4 bg-dark text-light border-top border-secondary border-opacity-25">
        <div class="container text-center">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start mb-2 mb-md-0">
                    <span class="fw-bold text-warning">comicsys.com</span> &copy; 2024-2026. Developing ASP.NET Core MVC Applications - SET01.
                </div>
                <div class="col-md-6 text-md-end text-white-50 small">
                    Database: <span class="badge bg-secondary">ComicSystem</span> | SQL Server / LocalDB
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

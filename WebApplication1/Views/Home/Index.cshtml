@{
    ViewData["Title"] = "Trang chủ";
    var recentRentals = ViewBag.RecentRentals as IEnumerable<Rental> ?? new List<Rental>();
}

<!-- Hero Section -->
<div class="p-5 mb-4 bg-white rounded-4 shadow-sm border border-slate-100 position-relative overflow-hidden">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <div class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-semibold mb-3">
                <i class="bi bi-stars me-1"></i> comicsys.com &bull; Set01 Practical Paper
            </div>
            <h1 class="display-5 fw-bold text-dark mb-3">Hệ Thống Thuê Truyện Tranh</h1>
            <p class="lead text-muted mb-4">
                Quản lý kho truyện tranh, thông tin khách hàng, xử lý đơn thuê sách và báo cáo thống kê chính xác, nhanh chóng theo đề thi thực hành ASP.NET Core MVC.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Rentals" asp-action="Create" class="btn btn-primary btn-lg rounded-pill px-4">
                    <i class="bi bi-cart-plus me-1"></i> Thuê truyện ngay (Q3)
                </a>
                <a asp-controller="Rentals" asp-action="Report" class="btn btn-outline-dark btn-lg rounded-pill px-4">
                    <i class="bi bi-bar-chart-line me-1"></i> Xem báo cáo (Q4)
                </a>
            </div>
        </div>
        <div class="col-lg-4 text-center mt-4 mt-lg-0">
            <div class="p-4 bg-light rounded-4 border d-inline-block shadow-sm">
                <i class="bi bi-book text-primary" style="font-size: 5rem;"></i>
                <div class="fw-bold text-secondary mt-2">ComicSystem Database</div>
                <div class="text-success small fw-semibold"><i class="bi bi-check-circle-fill"></i> MSSQL Connected</div>
            </div>
        </div>
    </div>
</div>

<!-- Metrics Overview -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="summary-stat-card d-flex align-items-center gap-3 shadow-sm">
            <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-journal-album"></i>
            </div>
            <div>
                <div class="text-muted small text-uppercase fw-bold">Tổng số truyện (Q1)</div>
                <div class="fs-3 fw-bold text-dark">@ViewBag.TotalBooks</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="summary-stat-card d-flex align-items-center gap-3 shadow-sm">
            <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="text-muted small text-uppercase fw-bold">Khách hàng đăng ký (Q2)</div>
                <div class="fs-3 fw-bold text-dark">@ViewBag.TotalCustomers</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="summary-stat-card d-flex align-items-center gap-3 shadow-sm">
            <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning">
                <i class="bi bi-receipt"></i>
            </div>
            <div>
                <div class="text-muted small text-uppercase fw-bold">Tổng lượt thuê (Q3)</div>
                <div class="fs-3 fw-bold text-dark">@ViewBag.TotalRentals</div>
            </div>
        </div>
    </div>
</div>

<!-- Exam Questions Quick Access Cards -->
<div class="row g-4 mb-4">
    <!-- Q1 -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-top border-primary border-4">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-primary">Question 1 (3đ)</span>
                    <i class="bi bi-journal-plus text-primary fs-4"></i>
                </div>
                <h5 class="card-title fw-bold">CRUD Comic Books</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Trang quản lý truyện tranh: Thêm mới, xem danh sách, cập nhật thông tin và xoá truyện vào bảng <code>ComicBooks</code>.
                </p>
                <div class="d-grid gap-2">
                    <a asp-controller="ComicBooks" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill">
                        Danh sách truyện
                    </a>
                    <a asp-controller="ComicBooks" asp-action="Create" class="btn btn-primary btn-sm rounded-pill">
                        + Thêm truyện mới
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Q2 -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-top border-success border-4">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-success">Question 2 (3đ)</span>
                    <i class="bi bi-person-plus text-success fs-4"></i>
                </div>
                <h5 class="card-title fw-bold">Customer Register</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Đăng ký khách hàng mới lần đầu sử dụng với Fullname, Phone number, Register date vào bảng <code>Customers</code>.
                </p>
                <div class="d-grid gap-2">
                    <a asp-controller="Customers" asp-action="Index" class="btn btn-outline-success btn-sm rounded-pill">
                        Danh sách khách
                    </a>
                    <a asp-controller="Customers" asp-action="Register" class="btn btn-success btn-sm rounded-pill">
                        + Đăng ký khách hàng
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Q3 -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-top border-warning border-4">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-warning text-dark">Question 3 (5đ)</span>
                    <i class="bi bi-cart-check text-warning fs-4"></i>
                </div>
                <h5 class="card-title fw-bold">Rental Book Page</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Tạo phiếu thuê truyện: Khách hàng, Rental date, Return date, Quantity, Price per day (Lưu vào cả <code>Rentals</code> và <code>RentalDetails</code>).
                </p>
                <div class="d-grid gap-2">
                    <a asp-controller="Rentals" asp-action="Index" class="btn btn-outline-warning text-dark btn-sm rounded-pill">
                        Lịch sử thuê
                    </a>
                    <a asp-controller="Rentals" asp-action="Create" class="btn btn-warning text-dark btn-sm rounded-pill fw-semibold">
                        + Tạo đơn thuê truyện
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Q4 -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-top border-info border-4">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-info text-dark">Question 4 (3đ)</span>
                    <i class="bi bi-table text-info fs-4"></i>
                </div>
                <h5 class="card-title fw-bold">Report All Books</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Báo cáo tất cả truyện đã thuê theo khoảng thời gian Start date - End date đúng bảng mẫu: No, Bookname, Rentaldate, Return date, Customer name, Quantity.
                </p>
                <div class="d-grid gap-2 mt-auto">
                    <a asp-controller="Rentals" asp-action="Report" class="btn btn-info text-dark btn-sm rounded-pill fw-semibold">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Xem báo cáo chi tiết
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Rentals Card -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Các đơn thuê gần đây</h5>
        <a asp-controller="Rentals" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">Xem tất cả</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã thuê</th>
                    <th>Khách hàng</th>
                    <th>Ngày thuê</th>
                    <th>Ngày trả</th>
                    <th>Truyện thuê</th>
                    <th>Số lượng</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (!recentRentals.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Chưa có đơn thuê truyện nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in recentRentals)
                    {
                        var detail = item.RentalDetails.FirstOrDefault();
                        <tr>
                            <td class="fw-bold">#@item.RentalID</td>
                            <td>@item.Customer?.FullName</td>
                            <td>@item.RentalDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.ReturnDate.ToString("dd/MM/yyyy")</td>
                            <td>@(detail?.ComicBook?.Title ?? "—")</td>
                            <td>@(detail?.Quantity ?? 0)</td>
                            <td>
                                <span class="badge @(item.Status == "Đang thuê" ? "badge-rental-active" : "badge-rental-completed") px-2 py-1 rounded-pill">
                                    @item.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

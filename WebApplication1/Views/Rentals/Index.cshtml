@model IEnumerable<WebApplication1.Models.Rental>

@{
    ViewData["Title"] = "Danh sách phiếu thuê truyện (Rentals)";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="badge bg-warning text-dark mb-2">Hệ thống thuê truyện</div>
        <h2 class="fw-bold mb-0">Danh Sách Phiếu Thuê Truyện (Rentals)</h2>
        <p class="text-muted small mb-0">Quản lý toàn bộ giao dịch mượn/trả truyện tranh trong hệ thống</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Report" class="btn btn-outline-dark rounded-pill px-3">
            <i class="bi bi-bar-chart-line me-1"></i> Báo cáo thuê (Q4)
        </a>
        <a asp-action="Create" class="btn btn-warning rounded-pill px-4 fw-bold text-dark shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Tạo phiếu thuê mới (Q3)
        </a>
    </div>
</div>

<!-- Rentals Table Card -->
<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover table-custom mb-0">
            <thead>
                <tr>
                    <th style="width: 90px;">Mã phiếu</th>
                    <th>Khách hàng</th>
                    <th>Ngày thuê</th>
                    <th>Ngày trả</th>
                    <th>Bộ truyện thuê</th>
                    <th>Số lượng</th>
                    <th>Giá / ngày</th>
                    <th>Trạng thái</th>
                    <th class="text-end" style="width: 120px;">Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-receipt-cutoff fs-1 d-block mb-2 text-secondary"></i>
                            Chưa có dữ liệu phiếu thuê nào. Hãy tạo phiếu thuê mới!
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var firstDetail = item.RentalDetails.FirstOrDefault();
                        <tr>
                            <td class="fw-bold text-secondary">#@item.RentalID</td>
                            <td>
                                <div class="fw-bold text-dark">
                                    <i class="bi bi-person text-primary me-1"></i>@item.Customer?.FullName
                                </div>
                                <div class="small text-muted">@item.Customer?.PhoneNumber</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.RentalDate.ToString("dd/MM/yyyy")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.ReturnDate.ToString("dd/MM/yyyy")
                                </span>
                            </td>
                            <td>
                                <span class="fw-semibold text-primary">
                                    @(firstDetail?.ComicBook?.Title ?? "—")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1">
                                    @(firstDetail?.Quantity ?? 0) cuốn
                                </span>
                            </td>
                            <td>
                                @(firstDetail != null ? firstDetail.PricePerDay.ToString("N0") + " đ" : "—")
                            </td>
                            <td>
                                <span class="badge @(item.Status == "Đang thuê" ? "badge-rental-active" : "badge-rental-completed") px-2 py-1 rounded-pill">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.RentalID" class="btn btn-sm btn-outline-info rounded-pill">
                                    <i class="bi bi-eye"></i> Xem
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<%- include('header.ejs') %>

    <div class="container">
        <div class="shop-section">
            <div class="shop-image">
                <img src="/uploads/default.jpg" alt="Phonh Lan"
                    onerror="this.src='https://images.unsplash.com/photo-1596700880313-2ac11689ee5e?ixlib=rb-4.0.3&auto=format&fit=crop&w=350&q=80'">
            </div>

            <div class="shop-form">
                <h2>Tree Shop</h2>
                <% if (error) { %>
                    <p class="error-text">
                        <%= error %>
                    </p>
                    <% } %>
                        <form action="/add" method="POST" enctype="multipart/form-data">
                            <div class="form-group">
                                <label for="treename">Tree Name</label>
                                <input type="text" id="treename" name="treename" placeholder="Phong lan" required>
                            </div>

                            <div class="form-group">
                                <label for="description">Description</label>
                                <textarea id="description" name="description"
                                    placeholder="Nhắc đến ý nghĩa của hoa phong lan..." required></textarea>
                            </div>

                            <div class="form-group">
                                <label for="image">Image</label>
                                <div style="display: flex; gap: 10px;">
                                    <input type="file" id="image" name="image" style="flex:1;">
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn-add">Add</button>
                                <button type="submit" formaction="/reset" formnovalidate
                                    class="btn-reset">Reset</button>
                            </div>
                        </form>
            </div>
        </div>

        <table class="tree-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Image</th>
                    <th>Description</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% if (trees && trees.length> 0) { %>
                    <% trees.forEach((tree, index)=> { %>
                        <tr>
                            <td>
                                <%= index + 1 %>
                            </td>
                            <td>
                                <%= tree.treename %>
                            </td>
                            <td>
                                <% if (tree.image) { %>
                                    <img src="<%= tree.image %>" class="td-image" alt="Tree Image">
                                    <% } else { %>
                                        No image
                                        <% } %>
                            </td>
                            <td style="max-width: 400px;">
                                <%= tree.description %>
                            </td>
                            <td>
                                <a href="#" class="action-icons" style="color: #6da7d4;" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <form action="/delete/<%= tree.id %>" method="POST" style="display:inline;"
                                    onsubmit="return confirm('Are you sure?');">
                                    <button type="submit" class="action-icons" style="color: #6da7d4;" title="Delete">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" style="text-align:center;">No trees available.</td>
                                </tr>
                                <% } %>
            </tbody>
        </table>
    </div>

    <%- include('footer.ejs') %>
@model ComicSystem.Models.Customer

@{
    ViewData["Title"] = "Thông tin Khách Hàng: " + Model.FullName;
}

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center p-4">
                <div class="bg-success-subtle text-success rounded-circle p-3 d-inline-flex mb-3">
                    <i class="bi bi-person-fill fs-1"></i>
                </div>
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-3">Mã khách hàng: #@Model.CustomerID</p>

                <div class="border-top pt-3 text-start">
                    <div class="mb-2">
                        <small class="text-muted d-block">Số điện thoại:</small>
                        <span class="fw-semibold text-dark"><i class="bi bi-telephone text-success me-1"></i>@Model.PhoneNumber</span>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted d-block">Ngày đăng ký thành viên:</small>
                        <span class="fw-semibold text-dark"><i class="bi bi-calendar-check text-primary me-1"></i>@Model.RegistrationDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div>
                        <small class="text-muted d-block">Tổng số lần thuê truyện:</small>
                        <span class="badge bg-primary fs-6">@Model.Rentals.Count đơn thuê</span>
                    </div>
                </div>

                <div class="mt-4">
                    <a asp-controller="Rentals" asp-action="Create" class="btn btn-outline-primary btn-sm w-100 rounded-pill mb-2">
                        <i class="bi bi-plus-circle me-1"></i> Tạo đơn thuê cho khách này
                    </a>
                    <a asp-action="Index" class="btn btn-light btn-sm w-100 rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history text-info me-2"></i>Lịch Sử Thuê Truyện
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mã Đơn</th>
                                <th>Ngày Thuê</th>
                                <th>Ngày Trả</th>
                                <th>Chi Tiết Truyện</th>
                                <th>Trạng Thái</th>
                                <th class="pe-3 text-end">Chi Tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Rentals != null && Model.Rentals.Any())
                            {
                                foreach (var rental in Model.Rentals)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">#@rental.RentalID</td>
                                        <td>@rental.RentalDate.ToString("dd/MM/yyyy")</td>
                                        <td>@rental.ReturnDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <ul class="list-unstyled mb-0 small">
                                                @foreach (var detail in rental.RentalDetails)
                                                {
                                                    <li>
                                                        <i class="bi bi-book text-muted me-1"></i>
                                                        <strong>@detail.ComicBook?.Title</strong> 
                                                        <span class="badge bg-secondary-subtle text-secondary ms-1">SL: @detail.Quantity</span>
                                                    </li>
                                                }
                                            </ul>
                                        </td>
                                        <td>
                                            @if (rental.Status == "Đang thuê")
                                            {
                                                <span class="badge bg-warning text-dark">@rental.Status</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">@rental.Status</span>
                                            }
                                        </td>
                                        <td class="pe-3 text-end">
                                            <a asp-controller="Rentals" asp-action="Details" asp-route-id="@rental.RentalID" class="btn btn-sm btn-outline-primary">
                                                Xem <i class="bi bi-arrow-right"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        Khách hàng này chưa có đơn thuê truyện nào.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

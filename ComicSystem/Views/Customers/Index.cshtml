@model IEnumerable<ComicSystem.Models.Customer>

@{
    ViewData["Title"] = "Quản lý Khách Hàng (Customers)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Khách hàng</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="bi bi-people text-success me-2"></i>Danh Sách Khách Hàng
        </h2>
    </div>
    <a asp-action="Register" class="btn btn-success rounded-pill px-3 shadow-sm">
        <i class="bi bi-person-plus me-1"></i> Đăng ký khách hàng mới
    </a>
</div>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Mã KH</th>
                    <th>Họ và Tên</th>
                    <th>Số Điện Thoại</th>
                    <th>Ngày Đăng Ký</th>
                    <th class="text-center pe-4" style="width: 200px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted fw-semibold">#@item.CustomerID</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-success-subtle text-success rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                        <i class="bi bi-person-fill fs-5"></i>
                                    </div>
                                    <div>
                                        <span class="fw-bold text-dark fs-6 d-block">@item.FullName</span>
                                        <span class="badge bg-light text-muted border">Khách quen</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <i class="bi bi-telephone text-success me-1"></i>
                                <span class="fw-semibold">@item.PhoneNumber</span>
                            </td>
                            <td class="text-muted">
                                <i class="bi bi-calendar3 me-1"></i>
                                @item.RegistrationDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-center pe-4">
                                <a asp-action="Details" asp-route-id="@item.CustomerID" class="btn btn-outline-info btn-sm">
                                    <i class="bi bi-clock-history me-1"></i> Lịch sử thuê
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary"></i>
                            Chưa có khách hàng nào đăng ký trong hệ thống.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

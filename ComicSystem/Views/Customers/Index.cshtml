@model IEnumerable<ComicSystem.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-people-fill"></i> Customers</h2>
        <p class="text-muted mb-0">Registered customers in the system</p>
    </div>
    <a asp-action="Register" class="btn btn-success btn-lg">
        <i class="bi bi-person-plus me-1"></i> Register New
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:60px">#</th>
                        <th>Full Name</th>
                        <th>Phone Number</th>
                        <th>Registration Date</th>
                        <th class="text-center" style="width:200px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int index = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@(index++)</td>
                            <td>
                                <i class="bi bi-person-circle text-muted me-1"></i>
                                <strong>@item.FullName</strong>
                            </td>
                            <td><i class="bi bi-telephone me-1 text-muted"></i>@item.PhoneNumber</td>
                            <td><i class="bi bi-calendar3 me-1 text-muted"></i>@item.Registration.ToString("MM/dd/yyyy")</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.CustomerID" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.CustomerID" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-person-x" style="font-size: 4rem; color: #b2bec3;"></i>
                <h5 class="mt-3 text-muted">No customers registered yet</h5>
                <p class="text-muted">Register the first customer to get started.</p>
                <a asp-action="Register" class="btn btn-success mt-2">
                    <i class="bi bi-person-plus me-1"></i> Register First Customer
                </a>
            </div>
        }
    </div>
</div>

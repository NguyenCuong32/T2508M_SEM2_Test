@model ComicSystem.ViewModels.CustomerRegisterViewModel

@{
    ViewData["Title"] = "Đăng ký Khách Hàng (Customer Register)";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-circle me-3 p-2 lh-1">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <span class="badge bg-success mb-1">Question 2 - 3 Điểm</span>
                <h3 class="fw-bold mb-0">Đăng Ký Khách Hàng Mới</h3>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <p class="text-muted small mb-4">
                    Khách hàng lần đầu sử dụng dịch vụ thuê truyện cần đăng ký thông tin cá nhân bao gồm Họ tên, Số điện thoại và Ngày đăng ký.
                </p>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyen Hung" autofocus />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-telephone"></i></span>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Ví dụ: 0912345678" />
                        </div>
                        <div class="form-text small text-muted">Định dạng số điện thoại Việt Nam gồm 10 chữ số.</div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="RegistrationDate" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-calendar-event"></i></span>
                            <input asp-for="RegistrationDate" type="date" class="form-control" />
                        </div>
                        <span asp-validation-for="RegistrationDate" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-person-check me-1"></i> Hoàn tất đăng ký
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

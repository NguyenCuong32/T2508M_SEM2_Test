@model IEnumerable<ComicSystem.Models.ComicBook>

@{
    ViewData["Title"] = "Comic Books";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-journal-richtext"></i> Comic Books</h2>
        <p class="text-muted mb-0">Manage your comic book collection</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">
        <i class="bi bi-plus-circle me-1"></i> Add New
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:60px">#</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Price/Day</th>
                        <th class="text-center" style="width:250px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int index = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@(index++)</td>
                            <td><strong>@item.Title</strong></td>
                            <td>@item.Author</td>
                            <td><span class="badge bg-success">$@item.PricePerDay.ToString("F2")</span></td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.ComicBookID" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.ComicBookID" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ComicBookID" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox" style="font-size: 4rem; color: #b2bec3;"></i>
                <h5 class="mt-3 text-muted">No comic books yet</h5>
                <p class="text-muted">Start by adding your first comic book to the collection.</p>
                <a asp-action="Create" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-circle me-1"></i> Add First Comic
                </a>
            </div>
        }
    </div>
</div>

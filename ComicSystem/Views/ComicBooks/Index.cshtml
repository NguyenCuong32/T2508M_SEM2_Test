@model IEnumerable<ComicSystem.Models.ComicBook>

@{
    ViewData["Title"] = "Quản lý Truyện Tranh (ComicBooks)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Truyện tranh</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="bi bi-journal-bookmark text-primary me-2"></i>Danh Sách Truyện Tranh
        </h2>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-3 shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Thêm truyện mới
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" class="form-control border-start-0" 
                           placeholder="Tìm kiếm theo tên sách hoặc tác giả..." value="@ViewData["CurrentFilter"]" />
                </div>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-dark rounded-pill px-4">
                    Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill ms-2">
                        <i class="bi bi-x-circle me-1"></i> Đặt lại
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Mã</th>
                    <th>Tên Sách</th>
                    <th>Tác Giả</th>
                    <th class="text-end">Giá Thuê / Ngày</th>
                    <th class="text-center pe-4" style="width: 220px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted fw-semibold">#@item.ComicBookID</td>
                            <td>
                                <span class="fw-bold text-dark fs-6">@item.Title</span>
                            </td>
                            <td class="text-muted">
                                <i class="bi bi-person me-1"></i>@item.Author
                            </td>
                            <td class="text-end fw-bold text-success">
                                @item.PricePerDay.ToString("N0") VNĐ
                            </td>
                            <td class="text-center pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.ComicBookID" class="btn btn-outline-info" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.ComicBookID" class="btn btn-outline-warning" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ComicBookID" class="btn btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            Không tìm thấy cuốn truyện tranh nào phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

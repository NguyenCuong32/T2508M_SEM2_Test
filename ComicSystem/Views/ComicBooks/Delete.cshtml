@model ComicSystem.Models.ComicBook

@{
    ViewData["Title"] = "Xác nhận xóa Truyện: " + Model.Title;
    bool canDelete = ViewBag.CanDelete ?? true;
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-circle me-3 p-2 lh-1">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h3 class="fw-bold mb-0 text-danger">Xóa Truyện Tranh</h3>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                @if (!canDelete)
                {
                    <div class="alert alert-warning d-flex align-items-center mb-4">
                        <i class="bi bi-exclamation-triangle-fill fs-3 text-warning me-3"></i>
                        <div>
                            <strong>Không thể xóa cuốn truyện này!</strong><br />
                            Truyện này đã được khách hàng thuê trong các đơn thuê trước đây. Để đảm bảo toàn vẹn dữ liệu và báo cáo tài chính, bạn không thể xóa.
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger d-flex align-items-center mb-4">
                        <i class="bi bi-exclamation-octagon-fill fs-3 text-danger me-3"></i>
                        <div>
                            <strong>Cảnh báo xóa dữ liệu!</strong><br />
                            Bạn có chắc chắn muốn xóa cuốn truyện tranh này khỏi hệ thống không? Hành động này không thể hoàn tác.
                        </div>
                    </div>
                }

                <div class="bg-light p-3 rounded-3 mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Mã truyện:</dt>
                        <dd class="col-sm-8 fw-bold">#@Model.ComicBookID</dd>

                        <dt class="col-sm-4 text-muted">Tên truyện:</dt>
                        <dd class="col-sm-8 fw-semibold fs-5 text-dark">@Model.Title</dd>

                        <dt class="col-sm-4 text-muted">Tác giả:</dt>
                        <dd class="col-sm-8 text-secondary">@Model.Author</dd>

                        <dt class="col-sm-4 text-muted">Giá thuê / ngày:</dt>
                        <dd class="col-sm-8 fw-bold text-success">@Model.PricePerDay.ToString("N0") VNĐ</dd>
                    </dl>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
                    @if (canDelete)
                    {
                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="ComicBookID" />
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash3 me-1"></i> Xác nhận xóa
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

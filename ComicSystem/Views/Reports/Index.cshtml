@model ComicSystem.Models.ReportViewModel

@{
    ViewData["Title"] = "Rental Reports";
}

<div class="mb-4">
    <h2><i class="bi bi-graph-up"></i> Rental Reports</h2>
    <p class="text-muted mb-0">View rental records by date range</p>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="post">
            <div class="row align-items-end g-3">
                <div class="col-md-4">
                    <label asp-for="StartDate" class="form-label">
                        <i class="bi bi-calendar-event me-1"></i>Start Date
                    </label>
                    <input asp-for="StartDate" class="form-control" type="date" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EndDate" class="form-label">
                        <i class="bi bi-calendar-check me-1"></i>End Date
                    </label>
                    <input asp-for="EndDate" class="form-control" type="date" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100 btn-lg">
                        <i class="bi bi-search me-1"></i> Generate Report
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Results != null)
{
    <div class="card">
        <div class="card-header text-white py-3" style="background: linear-gradient(135deg, #1e3a5f 0%, #0d9488 100%); border-radius: 12px 12px 0 0;">
            <div class="d-flex justify-content-between align-items-center">
                <strong>
                    <i class="bi bi-file-earmark-bar-graph me-2"></i>
                    Report: @Model.StartDate.ToString("MM/dd/yyyy") &mdash; @Model.EndDate.ToString("MM/dd/yyyy")
                </strong>
                @if (Model.Results.Any())
                {
                    <span class="badge bg-light text-dark">@Model.Results.Count record(s)</span>
                }
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Results.Any())
            {
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:60px">No</th>
                            <th>Book Name</th>
                            <th>Rental Date</th>
                            <th>Return Date</th>
                            <th>Customer Name</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Results)
                        {
                            <tr>
                                <td class="fw-bold text-muted">@item.No</td>
                                <td><strong>@item.BookName</strong></td>
                                <td>@item.RentalDate.ToString("MM/dd/yyyy")</td>
                                <td>@item.ReturnDate.ToString("MM/dd/yyyy")</td>
                                <td>
                                    <i class="bi bi-person-circle text-muted me-1"></i>@item.CustomerName
                                </td>
                                <td><span class="badge bg-info">@item.Quantity</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-search" style="font-size: 4rem; color: #b2bec3;"></i>
                    <h5 class="mt-3 text-muted">No records found</h5>
                    <p class="text-muted">No rental records match the selected date range.</p>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

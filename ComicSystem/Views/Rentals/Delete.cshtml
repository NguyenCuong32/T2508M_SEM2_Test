@model ComicSystem.Models.Rental

@{
    ViewData["Title"] = "Delete Rental";
}

<h2 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Rental</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Are you sure you want to delete this rental?</h5>
                <dl class="row mt-3">
                    <dt class="col-sm-4">Customer</dt>
                    <dd class="col-sm-8">@Model.Customer?.FullName</dd>

                    <dt class="col-sm-4">Rental Date</dt>
                    <dd class="col-sm-8">@Model.RentalDate.ToString("MM/dd/yyyy")</dd>

                    <dt class="col-sm-4">Return Date</dt>
                    <dd class="col-sm-8">@Model.ReturnDate.ToString("MM/dd/yyyy")</dd>

                    <dt class="col-sm-4">Books</dt>
                    <dd class="col-sm-8">
                        @foreach (var detail in Model.RentalDetails)
                        {
                            <span class="badge bg-info">@detail.ComicBook?.Title</span>
                        }
                    </dd>
                </dl>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="RentalID" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
                        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

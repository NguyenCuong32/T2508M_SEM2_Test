@model ComicSystem.Models.RentalViewModel

@{
    ViewData["Title"] = "Rent a Comic Book";
}

<div class="mb-4">
    <h2><i class="bi bi-cart-plus-fill"></i> Rent a Comic Book</h2>
    <p class="text-muted mb-0">Select a customer and comic book to create a rental</p>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CustomerID" class="form-label"><i class="bi bi-person me-1"></i>Customer</label>
                            <select asp-for="CustomerID" asp-items="Model.Customers" class="form-select">
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerID" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ComicBookID" class="form-label"><i class="bi bi-book me-1"></i>Comic Book</label>
                            <select asp-for="ComicBookID" asp-items="Model.ComicBooks" class="form-select">
                                <option value="">-- Select Comic Book --</option>
                            </select>
                            <span asp-validation-for="ComicBookID" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="RentalDate" class="form-label"><i class="bi bi-calendar-event me-1"></i>Rental Date</label>
                            <input asp-for="RentalDate" class="form-control" type="date" />
                            <span asp-validation-for="RentalDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ReturnDate" class="form-label"><i class="bi bi-calendar-check me-1"></i>Return Date</label>
                            <input asp-for="ReturnDate" class="form-control" type="date" />
                            <span asp-validation-for="ReturnDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Quantity" class="form-label"><i class="bi bi-stack me-1"></i>Quantity</label>
                            <input asp-for="Quantity" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                    </div>

                    <hr />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i> Rent Book</button>
                        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model ComicSystem.Models.Rental

@{
    ViewData["Title"] = "Rental Details";
}

<h2><i class="bi bi-eye"></i> Rental Details</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Customer</dt>
                    <dd class="col-sm-8">@Model.Customer?.FullName</dd>

                    <dt class="col-sm-4">Rental Date</dt>
                    <dd class="col-sm-8">@Model.RentalDate.ToString("MM/dd/yyyy")</dd>

                    <dt class="col-sm-4">Return Date</dt>
                    <dd class="col-sm-8">@Model.ReturnDate.ToString("MM/dd/yyyy")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.Status == "Active")
                        {
                            <span class="badge bg-success">@Model.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.Status</span>
                        }
                    </dd>
                </dl>

                <h5 class="mt-4">Rented Books</h5>
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Comic Book</th>
                            <th>Quantity</th>
                            <th>Price/Day</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.RentalDetails)
                        {
                            <tr>
                                <td>@detail.ComicBook?.Title</td>
                                <td>@detail.Quantity</td>
                                <td>$@detail.PricePerDay.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
            </div>
        </div>
    </div>
</div>

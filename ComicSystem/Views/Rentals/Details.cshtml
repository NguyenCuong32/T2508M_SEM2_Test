@model ComicSystem.Models.Rental

@{
    ViewData["Title"] = "Chi tiết Đơn Thuê #" + Model.RentalID;
    var durationDays = (Model.ReturnDate.Date - Model.RentalDate.Date).Days;
    if (durationDays <= 0) durationDays = 1;
    decimal grandTotal = Model.RentalDetails.Sum(d => d.PricePerDay * d.Quantity * durationDays);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Đơn thuê</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chi tiết #@Model.RentalID</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            Phiếu Thuê Truyện #@Model.RentalID
        </h2>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-printer me-1"></i> In phiếu thuê
        </button>
        <a asp-action="Create" class="btn btn-primary rounded-pill">
            <i class="bi bi-plus-lg me-1"></i> Tạo đơn mới
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Cột thông tin khách hàng & thời gian -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light py-3">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-person-badge text-primary me-1"></i> Thông Tin Khách Hàng
                </h6>
            </div>
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-1">@Model.Customer?.FullName</h5>
                <p class="text-muted small mb-3">Mã khách hàng: #@Model.CustomerID</p>

                <div class="mb-2">
                    <small class="text-muted d-block">Số điện thoại:</small>
                    <span class="fw-semibold"><i class="bi bi-telephone text-success me-1"></i>@Model.Customer?.PhoneNumber</span>
                </div>
                <div>
                    <small class="text-muted d-block">Ngày đăng ký:</small>
                    <span class="text-dark">@Model.Customer?.RegistrationDate.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light py-3">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-calendar-range text-info me-1"></i> Thời Gian Thuê
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Ngày bắt đầu thuê:</small>
                    <span class="fw-semibold text-primary fs-6">
                        <i class="bi bi-calendar-plus me-1"></i>@Model.RentalDate.ToString("dd/MM/yyyy")
                    </span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Ngày hẹn trả:</small>
                    <span class="fw-semibold text-danger fs-6">
                        <i class="bi bi-calendar-check me-1"></i>@Model.ReturnDate.ToString("dd/MM/yyyy")
                    </span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Thời lượng thuê:</small>
                    <span class="badge bg-light text-dark border fs-6">@durationDays ngày</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Trạng thái hiện tại:</small>
                    @if (Model.Status == "Đang thuê")
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle badge-status fs-6">
                            <i class="bi bi-clock me-1"></i>@Model.Status
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle badge-status fs-6">
                            <i class="bi bi-check-all me-1"></i>@Model.Status
                        </span>
                    }
                </div>

                @if (Model.Status == "Đang thuê")
                {
                    <form asp-action="Return" asp-route-id="@Model.RentalID" method="post" class="mt-4" onsubmit="return confirm('Xác nhận khách hàng đã trả sách?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success w-100 fw-semibold rounded-pill">
                            <i class="bi bi-arrow-return-left me-1"></i> Xác nhận trả sách
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- Cột chi tiết sách thuê & Tổng tiền -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-journal-check text-warning me-1"></i> Chi Tiết Đầu Sách Thuê
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Tên Truyện</th>
                                <th>Tác Giả</th>
                                <th class="text-end">Đơn Giá/Ngày</th>
                                <th class="text-center">Số Lượng</th>
                                <th class="text-end pe-3">Thành Tiền (@durationDays ngày)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.RentalDetails)
                            {
                                var lineTotal = detail.PricePerDay * detail.Quantity * durationDays;
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">@detail.ComicBook?.Title</td>
                                    <td class="text-muted">@detail.ComicBook?.Author</td>
                                    <td class="text-end text-muted">@detail.PricePerDay.ToString("N0") VNĐ</td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-dark">@detail.Quantity</span>
                                    </td>
                                    <td class="text-end pe-3 fw-bold text-success">
                                        @lineTotal.ToString("N0") VNĐ
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="ps-3 fw-bold text-uppercase">Tổng Cộng:</td>
                                <td class="text-center fw-bold">@Model.RentalDetails.Sum(d => d.Quantity) cuốn</td>
                                <td class="text-end pe-3 fs-5 fw-bold text-primary">
                                    @grandTotal.ToString("N0") VNĐ
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white p-3 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>

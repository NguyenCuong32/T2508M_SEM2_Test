<%- include("partials/header") %>

<h2 class="mb-4 text-center">

Tree Shop

</h2>

<% if(error!=""){ %>

<div class="alert alert-danger">

<%= error %>

</div>

<% } %>

<% if(success!=""){ %>

<div class="alert alert-success">

<%= success %>

</div>

<% } %>

<form action="/add" method="POST">

<div class="row">

<div class="col-md-4">

<input
type="text"
class="form-control"
name="treename"
placeholder="Tree Name">

</div>

<div class="col-md-4">

<input
type="text"
class="form-control"
name="description"
placeholder="Description">

</div>

<div class="col-md-4">

<input
type="text"
class="form-control"
name="image"
placeholder="Image URL">

</div>

</div>

<div class="mt-3">

<button class="btn btn-success">

Add Tree

</button>

</div>

</form>

<hr>

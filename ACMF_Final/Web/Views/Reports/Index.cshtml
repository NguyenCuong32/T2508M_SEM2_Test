@model ACMF_Final.Web.ViewModels.ReportViewModel

@{
    ViewData["Title"] = "Rental Report";
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="bi bi-bar-chart"></i> Rental Report</h1>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> Filter by Date Range</h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="post">
                <div class="row align-items-end">
                    <div class="col-md-4">
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" class="form-control" type="date" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EndDate" class="form-label"></label>
                        <input asp-for="EndDate" class="form-control" type="date" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Generate Report
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Results.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="bi bi-table"></i> Results 
                    <span class="badge bg-light text-dark">@Model.Results.Count record(s)</span>
                </h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Book Name</th>
                            <th>Customer</th>
                            <th>Rental Date</th>
                            <th>Return Date</th>
                            <th>Quantity</th>
                            <th>Price/Day</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rowIndex = 1;
                            decimal totalAll = 0;
                        }
                        @foreach (var item in Model.Results)
                        {
                            totalAll += item.TotalPrice;
                            <tr>
                                <td>@rowIndex</td>
                                <td><strong>@item.BookName</strong></td>
                                <td>@item.CustomerName</td>
                                <td>@item.RentalDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.ReturnDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.Quantity</td>
                                <td>@item.PricePerDay.ToString("N0") VND</td>
                                <td>@item.TotalPrice.ToString("N0") VND</td>
                            </tr>
                            rowIndex++;
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-warning">
                            <td colspan="7" class="text-end"><strong>Grand Total:</strong></td>
                            <td><strong>@totalAll.ToString("N0") VND</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
    else if (ViewContext.HttpContext.Request.Method == "POST")
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No rental records found for the selected date range.
        </div>
    }
</div>

@model IEnumerable<finaltest.Models.Customer>

@{
    ViewData["Title"] = "Quản lý Khách hàng";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i>Danh sách Khách hàng</h2>
        <p class="text-muted mb-0">Quản lý và đăng ký khách hàng mới (Bảng Customers - Question 2)</p>
    </div>
    <div>
        <a asp-action="Register" class="btn btn-success">
            <i class="bi bi-person-plus me-1"></i> Đăng ký khách hàng mới
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm theo họ tên hoặc số điện thoại..." />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary"><i class="bi bi-search me-1"></i> Tìm kiếm</button>
                @if (ViewData["CurrentFilter"] != null && !string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã KH</th>
                    <th>Họ và tên (Fullname)</th>
                    <th>Số điện thoại (Phone number)</th>
                    <th>Ngày đăng ký (Register date)</th>
                    <th>Số lần thuê</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Chưa có khách hàng nào trong hệ thống.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">#@item.CustomerID</span></td>
                            <td class="fw-semibold text-dark">
                                <i class="bi bi-person-circle text-primary me-1"></i>
                                @item.FullName
                            </td>
                            <td><span class="font-monospace">@item.PhoneNumber</span></td>
                            <td>@item.RegistrationDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-info text-dark">@(item.Rentals?.Count ?? 0) phiếu</span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="Rentals" asp-action="Create" asp-route-customerId="@item.CustomerID" class="btn btn-sm btn-outline-success me-1" title="Tạo phiếu thuê">
                                    <i class="bi bi-cart-plus me-1"></i> Thuê truyện
                                </a>
                                <a asp-action="Details" asp-route-id="@item.CustomerID" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

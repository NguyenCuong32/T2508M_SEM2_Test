@model finaltest.Models.Customer

@{
    ViewData["Title"] = "Chi tiết Khách hàng";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white">
                <h5 class="card-title mb-0"><i class="bi bi-person-vcard text-primary me-2"></i>Thông tin Khách hàng</h5>
                <span class="badge bg-primary">Mã KH #@Model.CustomerID</span>
            </div>
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <span class="text-muted d-block small">Họ và tên (Fullname):</span>
                        <span class="fw-bold fs-5 text-dark">@Model.FullName</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <span class="text-muted d-block small">Số điện thoại (Phone number):</span>
                        <span class="fw-bold fs-5 font-monospace text-primary">@Model.PhoneNumber</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <span class="text-muted d-block small">Ngày đăng ký (Register date):</span>
                        <span class="fw-semibold">@Model.RegistrationDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <span class="text-muted d-block small">Tổng số lần thuê:</span>
                        <span class="badge bg-info text-dark fs-6">@(Model.Rentals?.Count ?? 0) phiếu</span>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between py-3">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
                <a asp-controller="Rentals" asp-action="Create" asp-route-customerId="@Model.CustomerID" class="btn btn-primary">
                    <i class="bi bi-cart-plus me-1"></i> Tạo phiếu thuê cho khách này
                </a>
            </div>
        </div>

        @if (Model.Rentals != null && Model.Rentals.Any())
        {
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Lịch sử các phiếu thuê của khách hàng</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã phiếu</th>
                                <th>Ngày thuê</th>
                                <th>Ngày trả</th>
                                <th>Truyện tranh</th>
                                <th>Số lượng</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Rentals)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-dark border">#@r.RentalID</span></td>
                                    <td>@r.RentalDate.ToString("dd/MM/yyyy")</td>
                                    <td>@r.ReturnDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @foreach (var rd in r.RentalDetails)
                                        {
                                            <div><strong>@rd.ComicBook?.Title</strong> (@rd.PricePerDay.ToString("N0") đ/ngày)</div>
                                        }
                                    </td>
                                    <td>
                                        @r.RentalDetails.Sum(x => x.Quantity)
                                    </td>
                                    <td>
                                        <span class="badge @(r.Status == "Đang thuê" ? "badge-status-renting" : "badge-status-returned")">
                                            @r.Status
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Rentals" asp-action="Details" asp-route-id="@r.RentalID" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

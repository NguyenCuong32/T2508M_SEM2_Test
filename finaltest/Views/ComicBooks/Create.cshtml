@model finaltest.Models.ComicBook

@{
    ViewData["Title"] = "Thêm truyện tranh mới";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header py-3 bg-primary text-white">
                <h5 class="card-title mb-0"><i class="bi bi-plus-circle me-2"></i>Thêm truyện tranh mới (Question 1)</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" placeholder="Ví dụ: Conan, Doraemon, Dragon Ball..." />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Author" class="form-label fw-semibold"></label>
                        <input asp-for="Author" class="form-control" placeholder="Ví dụ: Gosho Aoyama, Fujiko F. Fujio..." />
                        <span asp-validation-for="Author" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PricePerDay" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="PricePerDay" class="form-control" type="number" step="500" placeholder="5000" />
                            <span class="input-group-text">VNĐ / ngày</span>
                        </div>
                        <span asp-validation-for="PricePerDay" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i> Lưu truyện tranh
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

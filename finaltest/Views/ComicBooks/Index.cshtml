@model IEnumerable<finaltest.Models.ComicBook>

@{
    ViewData["Title"] = "Quản lý Truyện tranh";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-journal-bookmark text-primary me-2"></i>Danh sách Truyện tranh</h2>
        <p class="text-muted mb-0">Quản lý thêm, sửa, xóa thông tin truyện tranh (Bảng ComicBooks - Question 1)</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Thêm truyện mới
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm theo tên truyện hoặc tác giả..." />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary"><i class="bi bi-search me-1"></i> Tìm kiếm</button>
                @if (ViewData["CurrentFilter"] != null && !string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã truyện</th>
                    <th>Tên truyện (Title)</th>
                    <th>Tác giả (Author)</th>
                    <th>Giá thuê / ngày (PricePerDay)</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không có truyện tranh nào được tìm thấy.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">#@item.ComicBookID</span></td>
                            <td class="fw-semibold text-primary">@item.Title</td>
                            <td>@item.Author</td>
                            <td class="fw-bold text-success">@item.PricePerDay.ToString("N0") VNĐ</td>
                            <td class="text-end">
                                <a asp-controller="Rentals" asp-action="Create" asp-route-comicBookId="@item.ComicBookID" class="btn btn-sm btn-outline-success me-1" title="Cho thuê truyện này">
                                    <i class="bi bi-cart-plus"></i> Thuê
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.ComicBookID" class="btn btn-sm btn-outline-primary me-1" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.ComicBookID" class="btn btn-sm btn-outline-info me-1" title="Chi tiết">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ComicBookID" class="btn btn-sm btn-outline-danger" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

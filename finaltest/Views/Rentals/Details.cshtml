@model finaltest.Models.Rental

@{
    ViewData["Title"] = "Chi tiết Phiếu thuê";
    var firstDetail = Model.RentalDetails.FirstOrDefault();
    int days = Math.Max(1, (Model.ReturnDate.Date - Model.RentalDate.Date).Days);
    decimal total = Model.RentalDetails.Sum(d => d.Quantity * d.PricePerDay * days);
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0"><i class="bi bi-receipt text-primary me-2"></i>Phiếu thuê #@Model.RentalID</h5>
                <span class="badge @(Model.Status == "Đang thuê" ? "badge-status-renting" : "badge-status-returned") fs-6">
                    @Model.Status
                </span>
            </div>
            <div class="card-body p-4">
                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Khách hàng thuê:</label>
                        <h5 class="fw-bold mb-1">@Model.Customer?.FullName</h5>
                        <p class="text-muted mb-0"><i class="bi bi-telephone me-1"></i>@Model.Customer?.PhoneNumber</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small">Thời gian thuê:</label>
                        <div class="fw-semibold">Ngày thuê: @Model.RentalDate.ToString("dd/MM/yyyy")</div>
                        <div class="fw-semibold">Ngày trả: @Model.ReturnDate.ToString("dd/MM/yyyy")</div>
                        <div class="text-primary small fw-bold">Tổng số ngày: @days ngày</div>
                    </div>
                </div>

                <h6 class="fw-bold border-bottom pb-2 mb-3"><i class="bi bi-book me-1"></i>Chi tiết truyện thuê (RentalDetails)</h6>
                <div class="table-responsive mb-4">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Tên truyện (Book name)</th>
                                <th>Tác giả</th>
                                <th class="text-center">Số lượng (Quantity)</th>
                                <th class="text-end">Đơn giá / ngày</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.RentalDetails)
                            {
                                var itemTotal = detail.Quantity * detail.PricePerDay * days;
                                <tr>
                                    <td class="fw-semibold text-primary">@detail.ComicBook?.Title</td>
                                    <td>@detail.ComicBook?.Author</td>
                                    <td class="text-center">@detail.Quantity</td>
                                    <td class="text-end">@detail.PricePerDay.ToString("N0") VNĐ</td>
                                    <td class="text-end fw-bold">@itemTotal.ToString("N0") VNĐ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light">
                                <td colspan="4" class="text-end fw-bold">Tổng cộng tiền thuê:</td>
                                <td class="text-end fw-bold fs-5 text-danger">@total.ToString("N0") VNĐ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                    @if (Model.Status == "Đang thuê")
                    {
                        <form asp-action="ReturnBook" asp-route-id="@Model.RentalID" method="post">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check2-all me-1"></i> Đánh dấu đã trả sách
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

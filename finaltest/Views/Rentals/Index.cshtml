@model IEnumerable<finaltest.Models.Rental>

@{
    ViewData["Title"] = "Quản lý Thuê truyện";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-cart-check text-primary me-2"></i>Danh sách Phiếu thuê truyện</h2>
        <p class="text-muted mb-0">Quản lý các lượt thuê truyện của khách hàng (Bảng Rentals & RentalDetails - Question 3)</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Tạo phiếu thuê mới
        </a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Khách hàng</th>
                    <th>Truyện tranh thuê</th>
                    <th>Ngày thuê (Rental Date)</th>
                    <th>Ngày trả (Return Date)</th>
                    <th>SL (Quantity)</th>
                    <th>Giá/ngày</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Chưa có phiếu thuê nào.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var firstDetail = item.RentalDetails.FirstOrDefault();
                        <tr>
                            <td><span class="badge bg-light text-dark border">#@item.RentalID</span></td>
                            <td class="fw-semibold">
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerID" class="text-decoration-none">
                                    <i class="bi bi-person-fill text-secondary me-1"></i>@item.Customer?.FullName
                                </a>
                            </td>
                            <td>
                                @if (item.RentalDetails.Any())
                                {
                                    @foreach (var rd in item.RentalDetails)
                                    {
                                        <div class="fw-bold text-primary">@rd.ComicBook?.Title</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có chi tiết</span>
                                }
                            </td>
                            <td>@item.RentalDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.ReturnDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-secondary">@(firstDetail?.Quantity ?? item.RentalDetails.Sum(d => d.Quantity))</span>
                            </td>
                            <td class="text-success fw-semibold">
                                @((firstDetail?.PricePerDay ?? 0).ToString("N0")) đ
                            </td>
                            <td>
                                <span class="badge @(item.Status == "Đang thuê" ? "badge-status-renting" : "badge-status-returned")">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    @if (item.Status == "Đang thuê")
                                    {
                                        <form asp-action="ReturnBook" asp-route-id="@item.RentalID" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Xác nhận đã trả">
                                                <i class="bi bi-check-all"></i> Trả sách
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.RentalID" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.RentalID" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phiếu thuê #@item.RentalID không?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@model IEnumerable<finaltest.Models.Rental>

@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero Banner -->
<div class="p-4 p-md-5 mb-4 rounded-3 text-white" style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-white text-primary mb-2 px-3 py-2 fw-semibold">ASP.NET Core MVC Application</span>
            <h1 class="display-5 fw-bold mb-3">ComicSys - Hệ Thống Thuê Truyện Tranh</h1>
            <p class="lead mb-4">
                Hệ thống quản lý dịch vụ thuê truyện tranh trực tuyến: quản lý đầu sách, đăng ký khách hàng, tạo phiếu thuê sách và xuất báo cáo thống kê theo kỳ.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Rentals" asp-action="Create" class="btn btn-warning btn-lg fw-bold text-dark shadow-sm">
                    <i class="bi bi-cart-plus me-1"></i> Thuê truyện ngay
                </a>
                <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-file-earmark-bar-graph me-1"></i> Xem báo cáo
                </a>
            </div>
        </div>
        <div class="col-lg-4 text-center d-none d-lg-block">
            <i class="bi bi-journal-album" style="font-size: 8rem; opacity: 0.85;"></i>
        </div>
    </div>
</div>

<!-- Quick Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary me-3">
                    <i class="bi bi-journal-bookmark fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@(ViewBag.TotalBooks ?? 0)</h3>
                    <small class="text-muted">Đầu truyện tranh</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success me-3">
                    <i class="bi bi-people fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@(ViewBag.TotalCustomers ?? 0)</h3>
                    <small class="text-muted">Khách hàng đăng ký</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning me-3">
                    <i class="bi bi-cart-check fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@(ViewBag.ActiveRentals ?? 0)</h3>
                    <small class="text-muted">Đang thuê</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info me-3">
                    <i class="bi bi-receipt fs-3"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">@(ViewBag.TotalRentals ?? 0)</h3>
                    <small class="text-muted">Tổng lượt thuê</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Features / Marking Schema Shortcuts -->
<h4 class="fw-bold mb-3"><i class="bi bi-check2-square text-primary me-2"></i>Chức năng theo yêu cầu đề thi</h4>
<div class="row g-3 mb-4">
    <!-- Question 1 -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge bg-primary">Question 1 (3 điểm)</span>
                    <i class="bi bi-book fs-4 text-primary"></i>
                </div>
                <h5 class="card-title fw-bold">CRUD Truyện tranh</h5>
                <p class="card-text text-muted small">Thêm, xem, sửa, xóa thông tin truyện tranh trong bảng ComicBooks.</p>
                <a asp-controller="ComicBooks" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">
                    Quản lý ComicBooks &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- Question 2 -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge bg-success">Question 2 (3 điểm)</span>
                    <i class="bi bi-person-plus fs-4 text-success"></i>
                </div>
                <h5 class="card-title fw-bold">Đăng ký khách hàng</h5>
                <p class="card-text text-muted small">Khách hàng lần đầu đăng ký: Fullname, Phone number, Register date.</p>
                <a asp-controller="Customers" asp-action="Register" class="btn btn-sm btn-outline-success w-100">
                    Đăng ký Customers &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- Question 3 -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge bg-warning text-dark">Question 3 (5 điểm)</span>
                    <i class="bi bi-cart4 fs-4 text-warning"></i>
                </div>
                <h5 class="card-title fw-bold">Trang thuê truyện</h5>
                <p class="card-text text-muted small">Thêm thuê truyện với Rental date, Return date, Quantity, Price/day.</p>
                <a asp-controller="Rentals" asp-action="Create" class="btn btn-sm btn-outline-warning text-dark w-100">
                    Thuê Rentals &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- Question 4 -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge bg-info text-dark">Question 4 (3 điểm)</span>
                    <i class="bi bi-table fs-4 text-info"></i>
                </div>
                <h5 class="card-title fw-bold">Báo cáo thuê truyện</h5>
                <p class="card-text text-muted small">Báo cáo tất cả sách thuê theo khoảng thời gian chuẩn form SET01.</p>
                <a asp-controller="Reports" asp-action="Index" class="btn btn-sm btn-outline-info text-dark w-100">
                    Xem Reports &rarr;
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Rentals -->
<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Các lượt thuê truyện gần đây</h5>
        <a asp-controller="Rentals" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Khách hàng</th>
                    <th>Truyện tranh</th>
                    <th>Ngày thuê</th>
                    <th>Ngày trả</th>
                    <th>Số lượng</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var rental in Model)
                    {
                        var firstDetail = rental.RentalDetails.FirstOrDefault();
                        <tr>
                            <td>#@rental.RentalID</td>
                            <td class="fw-semibold">@rental.Customer?.FullName</td>
                            <td class="text-primary fw-medium">@(firstDetail?.ComicBook?.Title ?? "N/A")</td>
                            <td>@rental.RentalDate.ToString("dd/MM/yyyy")</td>
                            <td>@rental.ReturnDate.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-secondary">@(firstDetail?.Quantity ?? 1)</span></td>
                            <td>
                                <span class="badge @(rental.Status == "Đang thuê" ? "badge-status-renting" : "badge-status-returned")">
                                    @rental.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-3 text-muted">Chưa có dữ liệu thuê truyện</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

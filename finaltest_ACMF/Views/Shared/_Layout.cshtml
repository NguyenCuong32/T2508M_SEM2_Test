<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - comicsys.com | Comic Rental System</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            --comic-accent: #f59e0b;
            --comic-accent-hover: #d97706;
            --body-bg: #f8fafc;
            --card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            --header-bg: #1e1b4b;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--body-bg);
            color: #334155;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-comic {
            background: var(--header-bg);
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            padding: 0.8rem 1rem;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.4rem;
            color: #ffffff !important;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .brand-badge {
            background: var(--comic-accent);
            color: #1e1b4b;
            font-size: 0.75rem;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 6px;
            text-transform: uppercase;
        }

        .nav-link {
            color: #cbd5e1 !important;
            font-weight: 500;
            padding: 0.5rem 0.9rem !important;
            border-radius: 8px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-link:hover, .nav-link.active {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.12);
        }

        .btn-rent-highlight {
            background: linear-gradient(135deg, #f59e0b 0%, #ea580c 100%);
            color: #ffffff !important;
            font-weight: 600;
            border: none;
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
            border-radius: 8px;
            padding: 0.5rem 1rem;
        }

        .btn-rent-highlight:hover {
            opacity: 0.95;
            transform: translateY(-1px);
        }

        .card-custom {
            border: none;
            border-radius: 16px;
            background: #ffffff;
            box-shadow: var(--card-shadow);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .card-custom:hover {
            box-shadow: 0 14px 28px rgba(0,0,0,0.08);
        }

        .page-header {
            background: #ffffff;
            border-radius: 16px;
            padding: 1.5rem 2rem;
            margin-bottom: 2rem;
            box-shadow: var(--card-shadow);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .page-title {
            font-size: 1.6rem;
            font-weight: 700;
            color: #1e293b;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .badge-status-renting {
            background-color: #fef3c7;
            color: #b45309;
            font-weight: 600;
            padding: 6px 12px;
            border-radius: 20px;
        }

        .badge-status-returned {
            background-color: #d1fae5;
            color: #065f46;
            font-weight: 600;
            padding: 6px 12px;
            border-radius: 20px;
        }

        .footer-comic {
            margin-top: auto;
            background: #111827;
            color: #94a3b8;
            padding: 1.5rem 0;
            font-size: 0.9rem;
        }

        @@media print {
            .navbar, .footer-comic, .btn, .no-print {
                display: none !important;
            }
            body {
                background-color: #ffffff;
            }
            .card-custom {
                box-shadow: none;
                border: 1px solid #e2e8f0;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-comic">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-book-open-reader text-warning"></i>
                    <span>ComicSys</span>
                    <span class="brand-badge">comicsys.com</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#comicNavbar" aria-controls="comicNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="comicNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ComicBooks" asp-action="Index">
                                <i class="fa-solid fa-book"></i> Quản lý Truyện (Q1)
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="customerDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-users"></i> Khách hàng (Q2)
                            </a>
                            <ul class="dropdown-menu border-0 shadow" aria-labelledby="customerDropdown">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Customers" asp-action="Register">
                                        <i class="fa-solid fa-user-plus text-primary me-2"></i> Đăng ký thành viên mới
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Customers" asp-action="Index">
                                        <i class="fa-solid fa-address-book text-secondary me-2"></i> Danh sách khách hàng
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Rentals" asp-action="Index">
                                <i class="fa-solid fa-receipt"></i> Lịch sử thuê
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reports" asp-action="Index">
                                <i class="fa-solid fa-chart-pie text-info"></i> Báo cáo thống kê (Q4)
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-rent-highlight" asp-controller="Rentals" asp-action="Create">
                            <i class="fa-solid fa-cart-plus me-1"></i> Thuê truyện ngay (Q3)
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-lg-4 py-4 flex-grow-1">
        <!-- Toast Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center" role="alert">
                <i class="fa-solid fa-circle-check fs-4 me-3 text-success"></i>
                <div>
                    <strong>Thành công!</strong> @TempData["SuccessMessage"]
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center" role="alert">
                <i class="fa-solid fa-circle-xmark fs-4 me-3 text-danger"></i>
                <div>
                    <strong>Lỗi!</strong> @TempData["ErrorMessage"]
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-comic text-center">
        <div class="container">
            <p class="mb-1 font-monospace">
                <i class="fa-solid fa-book-journal-whills text-warning me-1"></i> <strong>ComicSystem</strong> - Website: <span class="text-white">comicsys.com</span>
            </p>
            <small class="text-secondary">ASP.NET Core MVC Practical Application - SET01 | Quản lý hệ thống cho thuê truyện tranh</small>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

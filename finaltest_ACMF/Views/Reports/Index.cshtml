@model finaltest_ACMF.Models.RentalReportViewModel

@{
    ViewData["Title"] = "Báo cáo thuê truyện theo thời gian (Report)";
}

<div class="page-header no-print">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-chart-line text-info"></i> Báo Cáo Thuê Truyện Tranh
        </h1>
        <p class="text-muted mb-0">Question 4: Thống kê danh sách thuê truyện giữa Start Date và End Date</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-dark fw-semibold">
            <i class="fa-solid fa-print me-1"></i> In báo cáo (Print)
        </button>
    </div>
</div>

<!-- Date Range Filter Form -->
<div class="card card-custom p-4 mb-4 no-print">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label asp-for="StartDate" class="form-label fw-bold">
                <i class="fa-regular fa-calendar me-1 text-primary"></i> Từ ngày (Start Date):
            </label>
            <input asp-for="StartDate" type="date" class="form-control form-control-lg" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
        </div>

        <div class="col-md-4">
            <label asp-for="EndDate" class="form-label fw-bold">
                <i class="fa-regular fa-calendar-check me-1 text-success"></i> Đến ngày (End Date):
            </label>
            <input asp-for="EndDate" type="date" class="form-control form-control-lg" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
        </div>

        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-lg flex-grow-1 fw-semibold">
                <i class="fa-solid fa-magnifying-glass me-1"></i> Xem báo cáo
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg" title="Xem tất cả">
                <i class="fa-solid fa-arrows-rotate"></i> Tất cả
            </a>
        </div>
    </form>

    <!-- Preset Quick Filter Buttons -->
    <div class="d-flex flex-wrap gap-2 mt-3 pt-3 border-top">
        <small class="text-muted align-self-center me-2"><i class="fa-solid fa-bolt text-warning"></i> Chọn nhanh:</small>
        <a asp-action="Index" asp-route-startDate="2024-10-01" asp-route-endDate="2024-10-31" class="btn btn-sm btn-outline-info rounded-pill">
            Tháng 10/2024 (Dữ liệu đề bài)
        </a>
        <a asp-action="Index" asp-route-startDate="@DateTime.Today.ToString("yyyy-MM-01")" asp-route-endDate="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-secondary rounded-pill">
            Tháng này
        </a>
        <a asp-action="Index" asp-route-startDate="@DateTime.Today.ToString("yyyy-MM-dd")" asp-route-endDate="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-secondary rounded-pill">
            Hôm nay
        </a>
    </div>
</div>

<!-- Printable Paper Report -->
<div class="card card-custom p-4">
    <!-- Header banner matching the exam paper -->
    <div class="text-center mb-4 pb-3 border-bottom">
        <h6 class="text-uppercase text-secondary fw-bold letter-spacing-1 mb-1">Practice - Developing ASP.NET Core MVC Applications – Set01</h6>
        <h2 class="fw-bold text-dark mb-1">Developing ASP.NET Core MVC Applications - SET01</h2>
        <p class="text-muted mb-0">
            @if (Model.StartDate.HasValue && Model.EndDate.HasValue)
            {
                <span>Khoảng thời gian: <strong>@Model.StartDate.Value.ToString("dd/MM/yyyy")</strong> đến <strong>@Model.EndDate.Value.ToString("dd/MM/yyyy")</strong></span>
            }
            else if (Model.StartDate.HasValue)
            {
                <span>Từ ngày: <strong>@Model.StartDate.Value.ToString("dd/MM/yyyy")</strong></span>
            }
            else if (Model.EndDate.HasValue)
            {
                <span>Đến ngày: <strong>@Model.EndDate.Value.ToString("dd/MM/yyyy")</strong></span>
            }
            else
            {
                <span>Tất cả các bản ghi thuê truyện trong hệ thống</span>
            }
        </p>
    </div>

    <!-- Report Table exact structure from question paper -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr class="text-center">
                    <th style="width: 70px;">No</th>
                    <th class="text-start">Book name</th>
                    <th style="width: 150px;">Rental date</th>
                    <th style="width: 150px;">Return date</th>
                    <th class="text-start">Customer name</th>
                    <th style="width: 110px;">Quantity</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ReportItems != null && Model.ReportItems.Any())
                {
                    foreach (var item in Model.ReportItems)
                    {
                        <tr>
                            <td class="text-center fw-bold">@item.No</td>
                            <td class="fw-semibold text-primary">@item.BookName</td>
                            <td class="text-center">@item.RentalDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@item.ReturnDate.ToString("dd/MM/yyyy")</td>
                            <td class="fw-semibold">@item.CustomerName</td>
                            <td class="text-center fw-bold fs-6">@item.Quantity</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                            <p class="mb-0">Không tìm thấy bản ghi thuê truyện nào trong khoảng thời gian đã chọn.</p>
                        </td>
                    </tr>
                }
            </tbody>
            @if (Model.ReportItems != null && Model.ReportItems.Any())
            {
                <tfoot>
                    <tr class="table-light fw-bold">
                        <td colspan="5" class="text-end text-uppercase fs-6">Tổng số lượng truyện đã thuê (Total Quantity):</td>
                        <td class="text-center fs-5 text-danger">@Model.TotalQuantity</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>

    <!-- Print Footer Info -->
    <div class="mt-4 pt-3 border-top d-flex justify-content-between text-muted small">
        <div>Hệ thống quản lý: <strong>comicsys.com</strong></div>
        <div>Ngày xuất báo cáo: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
</div>

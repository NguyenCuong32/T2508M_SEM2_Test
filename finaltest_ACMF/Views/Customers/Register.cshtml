@model finaltest_ACMF.Models.Customer

@{
    ViewData["Title"] = "Đăng Ký Khách Hàng";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="page-header">
            <div>
                <h1 class="page-title">
                    <i class="fa-solid fa-user-plus text-primary"></i> Đăng Ký Thành Viên Mới
                </h1>
                <p class="text-muted mb-0">Question 2: Đăng ký thông tin khách hàng (Họ tên, Số điện thoại, Ngày đăng ký)</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-users me-1"></i> Danh sách
            </a>
        </div>

        <div class="card card-custom p-4">
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-bold">Họ và Tên khách hàng <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-user text-primary"></i></span>
                        <input asp-for="FullName" class="form-control form-control-lg" placeholder="Ví dụ: Nguyen Hung, Tran Van An..." />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label fw-bold">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-phone text-success"></i></span>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Ví dụ: 0912345678" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    <div class="form-text">Số điện thoại dùng để nhận diện và liên hệ khi trả truyện.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="RegistrationDate" class="form-label fw-bold">Ngày đăng ký</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-calendar-day text-info"></i></span>
                        <input asp-for="RegistrationDate" type="datetime-local" value="@Model.RegistrationDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
                    </div>
                    <span asp-validation-for="RegistrationDate" class="text-danger small"></span>
                    <div class="form-text">Mặc định là thời điểm hiện tại.</div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                    <a asp-action="Index" class="btn btn-light px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="fa-solid fa-user-check me-1"></i> Hoàn tất đăng ký
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

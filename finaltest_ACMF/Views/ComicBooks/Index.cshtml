@model IEnumerable<finaltest_ACMF.Models.ComicBook>

@{
    ViewData["Title"] = "Quản lý Truyện tranh";
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-book-bookmark text-primary"></i> Quản lý danh mục Truyện tranh
        </h1>
        <p class="text-muted mb-0">Question 1: Thêm, xem, sửa, xóa các cuốn truyện trong hệ thống</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary px-3 py-2 fw-semibold rounded-3 shadow-sm">
            <i class="fa-solid fa-plus-circle me-1"></i> Thêm truyện mới
        </a>
    </div>
</div>

<!-- Search Bar -->
<div class="card card-custom p-3 mb-4">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-9">
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control bg-light border-0" placeholder="Tìm kiếm theo tên truyện hoặc tác giả..." />
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark w-100 fw-medium">
                <i class="fa-solid fa-filter me-1"></i> Tìm kiếm
            </button>
            @if (ViewData["CurrentFilter"] != null)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
            }
        </div>
    </form>
</div>

<!-- Comic Books Table -->
<div class="card card-custom overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="text-uppercase fs-7 text-secondary">
                    <th class="ps-4">ID</th>
                    <th>Tên truyện (Title)</th>
                    <th>Tác giả (Author)</th>
                    <th>Giá thuê 1 ngày (Price/Day)</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">#@item.ComicBookID</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3">
                                        <i class="fa-solid fa-book fa-lg"></i>
                                    </div>
                                    <div>
                                        <a asp-action="Details" asp-route-id="@item.ComicBookID" class="fw-bold text-decoration-none text-dark d-block">
                                            @item.Title
                                        </a>
                                        <small class="text-muted">Mã: CB-@item.ComicBookID.ToString("D4")</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                    <i class="fa-solid fa-pen-nib text-secondary me-1"></i> @item.Author
                                </span>
                            </td>
                            <td>
                                <span class="fw-bold text-success fs-6">
                                    @item.PricePerDay.ToString("N0") VNĐ
                                </span>
                                <span class="text-muted small">/ngày</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-controller="Rentals" asp-action="Create" asp-route-comicBookId="@item.ComicBookID" class="btn btn-sm btn-outline-success" title="Thuê ngay cuốn này">
                                        <i class="fa-solid fa-cart-arrow-down"></i> Thuê
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.ComicBookID" class="btn btn-sm btn-outline-primary" title="Sửa">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.ComicBookID" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ComicBookID" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-book-open fa-3x mb-3 text-secondary opacity-50"></i>
                            <p class="mb-0">Chưa có truyện tranh nào trong cơ sở dữ liệu.</p>
                            <a asp-action="Create" class="btn btn-sm btn-primary mt-3">Thêm truyện đầu tiên</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

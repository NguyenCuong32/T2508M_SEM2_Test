@model finaltest_ACMF.Models.ComicBook

@{
    ViewData["Title"] = "Chi tiết truyện - " + Model.Title;
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-book-open text-primary"></i> @Model.Title
        </h1>
        <p class="text-muted mb-0">Tác giả: @Model.Author | Mã truyện: CB-@Model.ComicBookID.ToString("D4")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Rentals" asp-action="Create" asp-route-comicBookId="@Model.ComicBookID" class="btn btn-warning fw-semibold">
            <i class="fa-solid fa-cart-plus me-1"></i> Cho thuê cuốn này
        </a>
        <a asp-action="Edit" asp-route-id="@Model.ComicBookID" class="btn btn-outline-primary">
            <i class="fa-solid fa-pen-to-square me-1"></i> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card card-custom p-4 text-center">
            <div class="bg-primary bg-opacity-10 text-primary rounded-4 py-5 mb-3">
                <i class="fa-solid fa-book fa-5x"></i>
            </div>
            <h4 class="fw-bold mb-1">@Model.Title</h4>
            <p class="text-muted">Tác giả: @Model.Author</p>
            <div class="p-3 bg-light rounded-3 mb-3">
                <span class="text-muted d-block small">Giá thuê niêm yết</span>
                <span class="fs-4 fw-bold text-success">@Model.PricePerDay.ToString("N0") VNĐ</span>
                <span class="text-muted small">/ ngày</span>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card card-custom p-4">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="fa-solid fa-clock-rotate-left text-info"></i> Lịch sử cho thuê của truyện này
            </h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-secondary">
                            <th>Mã phiếu</th>
                            <th>Khách hàng</th>
                            <th>Ngày thuê</th>
                            <th>Ngày hẹn trả</th>
                            <th>Số lượng</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RentalDetails != null && Model.RentalDetails.Any())
                        {
                            foreach (var detail in Model.RentalDetails)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Rentals" asp-action="Details" asp-route-id="@detail.RentalID" class="fw-bold text-decoration-none">
                                            #@detail.RentalID
                                        </a>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@(detail.Rental?.Customer?.FullName ?? "N/A")</span>
                                        <div class="small text-muted">@(detail.Rental?.Customer?.PhoneNumber)</div>
                                    </td>
                                    <td>@(detail.Rental?.RentalDate.ToString("dd/MM/yyyy"))</td>
                                    <td>@(detail.Rental?.ReturnDate.ToString("dd/MM/yyyy"))</td>
                                    <td><span class="badge bg-secondary">@detail.Quantity cuốn</span></td>
                                    <td>
                                        @if (detail.Rental?.Status == "Đang thuê")
                                        {
                                            <span class="badge-status-renting">@detail.Rental.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge-status-returned">@(detail.Rental?.Status ?? "N/A")</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    Cuốn truyện này chưa có lượt thuê nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

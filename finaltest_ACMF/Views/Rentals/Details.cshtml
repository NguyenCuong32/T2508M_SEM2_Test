@model finaltest_ACMF.Models.Rental

@{
    ViewData["Title"] = "Chi tiết Phiếu thuê #" + Model.RentalID;
    int rentalDays = Math.Max(1, (Model.ReturnDate.Date - Model.RentalDate.Date).Days);
    decimal grandTotal = Model.RentalDetails.Sum(d => d.Quantity * d.PricePerDay * rentalDays);
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-file-invoice text-primary"></i> Phiếu Thuê Truyện #@Model.RentalID.ToString("D4")
        </h1>
        <p class="text-muted mb-0">Ngày tạo phiếu: @Model.RentalDate.ToString("dd/MM/yyyy") | Khách hàng: @(Model.Customer?.FullName)</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary">
            <i class="fa-solid fa-print me-1"></i> In phiếu
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card card-custom p-4 mb-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2">
                <i class="fa-solid fa-book-open text-primary me-1"></i> Danh mục truyện thuê
            </h5>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tên truyện</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá / ngày</th>
                            <th class="text-center">Số ngày</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.RentalDetails)
                        {
                            var lineTotal = detail.Quantity * detail.PricePerDay * rentalDays;
                            <tr>
                                <td>
                                    <div class="fw-bold">@(detail.ComicBook?.Title)</div>
                                    <small class="text-muted">Tác giả: @(detail.ComicBook?.Author)</small>
                                </td>
                                <td class="text-center fw-bold">@detail.Quantity</td>
                                <td class="text-end">@detail.PricePerDay.ToString("N0") VNĐ</td>
                                <td class="text-center">@rentalDays ngày</td>
                                <td class="text-end fw-bold text-success">@lineTotal.ToString("N0") VNĐ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light">
                            <td colspan="4" class="text-end fw-bold fs-6">TỔNG CỘNG:</td>
                            <td class="text-end fw-bold fs-5 text-danger">@grandTotal.ToString("N0") VNĐ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Customer Info Card -->
        <div class="card card-custom p-4 mb-4">
            <h6 class="fw-bold text-uppercase text-secondary small mb-3">Thông tin Khách Hàng</h6>
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                    <i class="fa-solid fa-user-check fa-lg"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">@(Model.Customer?.FullName)</h5>
                    <small class="text-muted">ID: #@Model.CustomerID</small>
                </div>
            </div>
            <div class="p-3 bg-light rounded-3">
                <div class="mb-2">
                    <small class="text-muted d-block">Số điện thoại:</small>
                    <span class="fw-bold"><i class="fa-solid fa-phone me-1 text-success"></i> @(Model.Customer?.PhoneNumber)</span>
                </div>
                <div>
                    <small class="text-muted d-block">Ngày đăng ký:</small>
                    <span>@(Model.Customer?.RegistrationDate.ToString("dd/MM/yyyy HH:mm"))</span>
                </div>
            </div>
        </div>

        <!-- Rental Status & Actions -->
        <div class="card card-custom p-4">
            <h6 class="fw-bold text-uppercase text-secondary small mb-3">Thông tin Phiếu</h6>
            <div class="mb-3">
                <small class="text-muted d-block">Ngày thuê:</small>
                <span class="fw-bold"><i class="fa-regular fa-calendar-check text-success me-1"></i> @Model.RentalDate.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="mb-3">
                <small class="text-muted d-block">Ngày hẹn trả:</small>
                <span class="fw-bold"><i class="fa-regular fa-calendar-xmark text-danger me-1"></i> @Model.ReturnDate.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="mb-3">
                <small class="text-muted d-block">Trạng thái:</small>
                @if (Model.Status == "Đang thuê")
                {
                    <span class="badge-status-renting d-inline-block mt-1">@Model.Status</span>
                }
                else
                {
                    <span class="badge-status-returned d-inline-block mt-1">@Model.Status</span>
                }
            </div>

            @if (Model.Status == "Đang thuê")
            {
                <form asp-action="ReturnRental" asp-route-id="@Model.RentalID" method="post" class="mt-3">
                    <button type="submit" class="btn btn-success w-100 fw-bold">
                        <i class="fa-solid fa-check-double me-1"></i> Xác nhận đã trả sách
                    </button>
                </form>
            }
        </div>
    </div>
</div>

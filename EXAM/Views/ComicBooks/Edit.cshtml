@model EXAM.Models.ComicBook

@{
    ViewData["Title"] = "Chỉnh sửa Truyện tranh";
}

<div class="container py-4" style="max-width: 680px;">
    <!-- Breadcrumb / Back button -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="modern-card">
        <div class="modern-card-header bg-light">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon-wrapper stat-icon-warning" style="width: 44px; height: 44px; font-size: 1.2rem;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Chỉnh sửa Truyện tranh</h5>
                    <small class="text-muted">Cập nhật thông tin truyện tranh trong cơ sở dữ liệu</small>
                </div>
            </div>
            <span class="badge-clean badge-clean-secondary fs-6">Mã #@Model.ComicBookID</span>
        </div>

        <div class="modern-card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="modern-alert modern-alert-danger mb-4" role="alert"></div>

                <input type="hidden" asp-for="ComicBookID" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">
                        Tiêu đề truyện <span class="text-danger">*</span>
                    </label>
                    <div class="input-group modern-input-group">
                        <span class="input-group-text bg-white text-muted">
                            <i class="bi bi-book"></i>
                        </span>
                        <input asp-for="Title" class="form-control" />
                    </div>
                    <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Author" class="form-label">
                        Tác giả
                    </label>
                    <div class="input-group modern-input-group">
                        <span class="input-group-text bg-white text-muted">
                            <i class="bi bi-person"></i>
                        </span>
                        <input asp-for="Author" class="form-control" />
                    </div>
                    <span asp-validation-for="Author" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="PricePerDay" class="form-label">
                        Đơn giá thuê theo ngày <span class="text-danger">*</span>
                    </label>
                    <div class="input-group modern-input-group">
                        <span class="input-group-text bg-white text-muted">
                            <i class="bi bi-cash"></i>
                        </span>
                        <input asp-for="PricePerDay" type="number" step="500" min="0" class="form-control" />
                        <span class="input-group-text bg-light text-muted fw-semibold">VNĐ / ngày</span>
                    </div>
                    <span asp-validation-for="PricePerDay" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-modern btn-modern-outline">
                        Hủy thay đổi
                    </a>
                    <button type="submit" class="btn btn-modern btn-modern-primary px-4">
                        <i class="bi bi-check2-circle"></i> Lưu cập nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


@model EXAM.Models.ViewModels.CreateRentalViewModel

@{
    ViewData["Title"] = "CÂU 3 - Thêm đơn thuê sách mới";
}

<div class="container py-4">
    <!-- Breadcrumb / Back button -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách đơn thuê
        </a>
    </div>

    <div class="modern-card">
        <div class="modern-card-header bg-light">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon-wrapper stat-icon-primary" style="width: 44px; height: 44px; font-size: 1.2rem;">
                    <i class="bi bi-cart-plus"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark mb-0">CÂU 3: Thêm đơn thuê sách mới</h5>
                    <small class="text-muted">Chèn đồng thời vào bảng Rentals & RentalDetails với Database Transaction</small>
                </div>
            </div>
            <span class="badge-clean badge-clean-primary">Transaction Safe</span>
        </div>

        <div class="modern-card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="modern-alert modern-alert-danger mb-4" role="alert"></div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="CustomerID" class="form-label">
                            Khách hàng thuê <span class="text-danger">*</span>
                        </label>
                        <div class="input-group modern-input-group">
                            <span class="input-group-text bg-white text-muted">
                                <i class="bi bi-person"></i>
                            </span>
                            <select asp-for="CustomerID" class="form-select border-start-0 ps-0" asp-items="ViewBag.CustomerID">
                                <option value="">-- Chọn khách hàng --</option>
                            </select>
                        </div>
                        <span asp-validation-for="CustomerID" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <label asp-for="RentalDate" class="form-label">
                            Ngày thuê <span class="text-danger">*</span>
                        </label>
                        <div class="input-group modern-input-group">
                            <span class="input-group-text bg-white text-muted">
                                <i class="bi bi-calendar-check"></i>
                            </span>
                            <input asp-for="RentalDate" type="date" class="form-control border-start-0 ps-0" />
                        </div>
                        <span asp-validation-for="RentalDate" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <label asp-for="ReturnDate" class="form-label">
                            Ngày dự kiến trả
                        </label>
                        <div class="input-group modern-input-group">
                            <span class="input-group-text bg-white text-muted">
                                <i class="bi bi-calendar-x"></i>
                            </span>
                            <input asp-for="ReturnDate" type="date" class="form-control border-start-0 ps-0" />
                        </div>
                        <span asp-validation-for="ReturnDate" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-book text-primary"></i>
                        Chọn danh mục truyện cho đơn thuê
                    </h6>
                    <span class="text-muted small">Tích chọn và nhập số lượng</span>
                </div>

                <div class="modern-table-container mb-4">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 70px;">Chọn</th>
                                <th>Tiêu đề truyện</th>
                                <th class="text-end" style="width: 180px;">Đơn giá thuê</th>
                                <th class="text-center" style="width: 150px;">Số lượng thuê</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Books.Count; i++)
                            {
                                <tr>
                                    <td class="text-center">
                                        <input type="hidden" asp-for="Books[i].ComicBookID" />
                                        <input type="hidden" asp-for="Books[i].Title" />
                                        <input type="hidden" asp-for="Books[i].PricePerDay" />
                                        <input type="checkbox" asp-for="Books[i].IsSelected" class="form-check-input shadow-none" style="width: 1.25rem; height: 1.25rem; cursor: pointer;" />
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">@Model.Books[i].Title</span>
                                    </td>
                                    <td class="text-end">
                                        <span class="badge-clean badge-clean-success fw-bold">
                                            @Model.Books[i].PricePerDay.ToString("N0") VNĐ
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <input type="number" asp-for="Books[i].Quantity" min="1" max="100" class="form-control form-control-sm text-center mx-auto" style="width: 85px; border-radius: 6px;" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-modern btn-modern-outline">
                        Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-modern btn-modern-primary px-4">
                        <i class="bi bi-check2-circle"></i> Xác nhận tạo đơn thuê
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


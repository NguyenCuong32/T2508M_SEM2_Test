@model EXAM.Models.Rental

@{
    ViewData["Title"] = "Chi tiết Đơn thuê sách";
    decimal totalPerDay = Model.RentalDetails?.Sum(x => x.Quantity * x.PricePerDay) ?? 0;
}

<div class="container py-4" style="max-width: 880px;">
    <!-- Breadcrumb / Back button -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted fw-semibold small d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách đơn thuê
        </a>
    </div>

    <div class="modern-card">
        <div class="modern-card-header bg-light">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon-wrapper stat-icon-primary" style="width: 44px; height: 44px; font-size: 1.2rem;">
                    <i class="bi bi-receipt"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Chi tiết Đơn thuê sách #@Model.RentalID</h5>
                    <small class="text-muted">Thông tin khách hàng và danh sách truyện chi tiết</small>
                </div>
            </div>
            <span class="badge-clean badge-clean-warning fs-6">@(Model.Status ?? "Đang thuê")</span>
        </div>

        <div class="modern-card-body">
            <!-- Customer & Rental Info Card -->
            <div class="row g-3 mb-4 p-3 bg-light rounded-3 border">
                <div class="col-md-6">
                    <span class="text-muted small text-uppercase fw-bold d-block">Khách hàng thuê</span>
                    <div class="fs-5 fw-bold text-dark mt-1 d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle text-primary"></i>
                        <span>@(Model.Customer?.FullName ?? "N/A")</span>
                    </div>
                    <div class="text-muted small mt-1">
                        <i class="bi bi-telephone me-1"></i>SĐT: @(Model.Customer?.PhoneNumber ?? "Chưa cập nhật")
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <span class="text-muted small text-uppercase fw-bold d-block">Ngày thuê</span>
                    <div class="fs-6 fw-bold text-secondary mt-1">
                        <i class="bi bi-calendar-check text-success me-1"></i>
                        @Model.RentalDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <span class="text-muted small text-uppercase fw-bold d-block">Ngày hẹn trả</span>
                    <div class="fs-6 fw-bold text-secondary mt-1">
                        <i class="bi bi-calendar-x text-warning me-1"></i>
                        @(Model.ReturnDate.HasValue ? Model.ReturnDate.Value.ToString("dd/MM/yyyy") : "-")
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-list-check text-primary"></i>
                    Danh mục truyện được thuê (RentalDetails)
                </h6>
                <span class="badge-clean badge-clean-secondary">@(Model.RentalDetails?.Count ?? 0) tựa truyện</span>
            </div>

            <div class="modern-table-container mb-4">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Tên truyện tranh</th>
                            <th class="text-center" style="width: 120px;">Số lượng</th>
                            <th class="text-end" style="width: 170px;">Đơn giá/ngày</th>
                            <th class="text-end" style="width: 190px;">Thành tiền/ngày</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RentalDetails != null && Model.RentalDetails.Any())
                        {
                            foreach (var item in Model.RentalDetails)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@(item.ComicBook?.Title ?? "N/A")</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge-clean badge-clean-primary fw-bold">@item.Quantity cuốn</span>
                                    </td>
                                    <td class="text-end text-secondary">
                                        @item.PricePerDay.ToString("N0") VNĐ
                                    </td>
                                    <td class="text-end fw-bold text-success">
                                        @((item.Quantity * item.PricePerDay).ToString("N0")) VNĐ
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="bg-light">
                            <td colspan="3" class="text-end fw-bold text-dark">Tổng phí thuê theo ngày:</td>
                            <td class="text-end fs-5 fw-bold text-success">
                                @totalPerDay.ToString("N0") VNĐ / ngày
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <a asp-action="Index" class="btn btn-modern btn-modern-outline">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
                <a asp-action="Report" class="btn btn-modern btn-modern-outline">
                    <i class="bi bi-bar-chart-line text-primary"></i> Xem báo cáo tổng hợp 
                </a>
            </div>
        </div>
    </div>
</div>

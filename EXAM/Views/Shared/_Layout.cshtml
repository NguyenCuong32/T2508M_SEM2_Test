<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ComicBooks System</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Modern Clean Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg modern-navbar">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="ComicBooks" asp-action="Index">
                    <span class="brand-icon">
                        <i class="bi bi-book-half"></i>
                    </span>
                    <span>Comic<span class="text-primary">Books</span></span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="ComicBooks" asp-action="Index">
                                <i class="bi bi-collection"></i>
                                <span>Truyện tranh</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Customers" asp-action="Index">
                                <i class="bi bi-people"></i>
                                <span>Khách hàng</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Rentals" asp-action="Index">
                                <i class="bi bi-journal-bookmark"></i>
                                <span>Thuê sách</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Rentals" asp-action="Report">
                                <i class="bi bi-bar-chart-line"></i>
                                <span>Báo cáo thuê sách</span>
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="ComicBooks" asp-action="Create" class="btn btn-modern btn-modern-primary">
                            <i class="bi bi-plus-lg"></i>
                            <span>Thêm truyện</span>
                        </a>
                        <a asp-controller="Rentals" asp-action="Create" class="btn btn-modern btn-modern-success">
                            <i class="bi bi-cart-plus"></i>
                            <span>Tạo đơn thuê</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="modern-footer">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="brand-icon" style="width: 26px; height: 26px; font-size: 0.85rem; border-radius: 6px;">
                    <i class="bi bi-book-half"></i>
                </span>
                <span class="fw-semibold text-dark">ComicBooks Management System</span>
            </div>
            <div>
                <span>&copy; 2026 Modern Clean UI &bull; ASP.NET Core &bull; SQL Server</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


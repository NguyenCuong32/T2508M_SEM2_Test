@model IEnumerable<EXAM.Models.Customer>

@{
    ViewData["Title"] = "Danh sách Khách hàng";
}

<div class="mb-4">
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <span>Quản lý Khách hàng</span>
                <span class="badge-clean badge-clean-success fs-6">Câu 2</span>
            </h2>
            <p class="text-muted mb-0">Danh sách khách hàng đã đăng ký sử dụng dịch vụ thuê truyện trong bảng Customers</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-modern btn-modern-success">
                <i class="bi bi-person-plus"></i> Đăng ký khách hàng mới
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="modern-alert modern-alert-success mb-4 alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div class="flex-grow-1">
                <strong>Thành công!</strong> @TempData["Success"]
            </div>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="modern-table-container">
        <table class="modern-table">
            <thead>
                <tr>
                    <th class="text-center" style="width: 80px;">Mã #</th>
                    <th>Họ và tên</th>
                    <th>Số điện thoại</th>
                    <th>Ngày đăng ký</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <span class="badge-clean badge-clean-secondary">#@item.CustomerID</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                    <div class="stat-icon-wrapper stat-icon-success" style="width: 34px; height: 34px; font-size: 0.95rem; border-radius: 50%;">
                                        <i class="bi bi-person"></i>
                                    </div>
                                    <span>@item.FullName</span>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.PhoneNumber))
                                {
                                    <span class="text-secondary"><i class="bi bi-telephone me-1 text-muted"></i>@item.PhoneNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Chưa có SĐT</span>
                                }
                            </td>
                            <td class="text-secondary">
                                <i class="bi bi-calendar-event me-1 text-muted"></i>
                                @(item.RegisterDate.HasValue ? item.RegisterDate.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 opacity-50"></i>
                            Chưa có khách hàng nào trong hệ thống.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


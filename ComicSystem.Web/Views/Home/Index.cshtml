@model IEnumerable<ComicSystem.Web.Models.Rental>

@{
    ViewData["Title"] = "Trang Chủ - ComicSystem";
    int totalBooks = ViewBag.TotalBooks ?? 0;
    int totalCustomers = ViewBag.TotalCustomers ?? 0;
    int activeRentals = ViewBag.ActiveRentals ?? 0;
    int totalRentals = ViewBag.TotalRentals ?? 0;
}

<div class="p-4 p-md-5 mb-4 rounded-3 text-white bg-primary shadow-sm" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
    <div class="col-md-10 px-0">
        <span class="badge bg-warning text-dark px-3 py-2 mb-2 fw-semibold">FPT Aptech - Practical Paper SET01</span>
        <h1 class="display-5 fw-bold">Hệ Thống Thuê Truyện Tranh - ComicSystem</h1>
        <p class="lead my-3">
            Hệ thống quản lý hoạt động thuê truyện tranh trực tuyến (comicsys.com). Quản lý kho sách, đăng ký độc giả, lập phiếu thuê và báo cáo thống kê chính xác theo khoảng thời gian.
        </p>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <a asp-controller="ComicBooks" asp-action="Index" class="btn btn-light btn-lg px-4 fw-semibold text-primary">
                <i class="bi bi-book me-1"></i> Quản lý truyện (Q1)
            </a>
            <a asp-controller="Customers" asp-action="Register" class="btn btn-outline-light btn-lg px-4">
                <i class="bi bi-person-plus me-1"></i> Đăng ký độc giả (Q2)
            </a>
            <a asp-controller="Rentals" asp-action="Create" class="btn btn-warning btn-lg px-4 fw-bold">
                <i class="bi bi-cart-plus me-1"></i> Thuê truyện ngay (Q3)
            </a>
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                <i class="bi bi-file-earmark-bar-graph me-1"></i> Xem báo cáo (Q4)
            </a>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary fs-3">
                    <i class="bi bi-book"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small text-uppercase fw-bold">Tổng đầu sách</h6>
                    <h3 class="fw-bold mb-0 text-dark">@totalBooks</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success fs-3">
                    <i class="bi bi-people"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small text-uppercase fw-bold">Khách hàng</h6>
                    <h3 class="fw-bold mb-0 text-dark">@totalCustomers</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3 text-warning fs-3">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small text-uppercase fw-bold">Đang thuê</h6>
                    <h3 class="fw-bold mb-0 text-dark">@activeRentals</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info fs-3">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1 small text-uppercase fw-bold">Tổng lượt thuê</h6>
                    <h3 class="fw-bold mb-0 text-dark">@totalRentals</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Rentals & Quick Links -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Phiếu Thuê Gần Đây</h5>
                <a asp-controller="Rentals" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã</th>
                            <th>Khách hàng</th>
                            <th>Truyện</th>
                            <th>Ngày thuê</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">Chưa có giao dịch thuê sách nào.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-secondary">#@r.RentalID</td>
                                    <td class="fw-semibold">@(r.Customer?.FullName ?? "N/A")</td>
                                    <td>
                                        @foreach (var rd in r.RentalDetails)
                                        {
                                            <span class="badge bg-light text-dark border me-1">@(rd.ComicBook?.Title ?? "")</span>
                                        }
                                    </td>
                                    <td>@r.RentalDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge @(r.Status == "Đang thuê" ? "bg-warning text-dark" : "bg-success")">
                                            @r.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-card-checklist me-2 text-primary"></i>Cấu Trúc Đề Thi SET01</h5>
            </div>
            <div class="list-group list-group-flush">
                <a asp-controller="ComicBooks" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">Câu 1: CRUD Comic Books</div>
                        <small class="text-muted">Thêm, sửa, xóa, tìm kiếm truyện</small>
                    </div>
                    <span class="badge bg-primary rounded-pill">3 điểm</span>
                </a>
                <a asp-controller="Customers" asp-action="Register" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">Câu 2: Customer Register</div>
                        <small class="text-muted">Đăng ký khách hàng mới</small>
                    </div>
                    <span class="badge bg-primary rounded-pill">3 điểm</span>
                </a>
                <a asp-controller="Rentals" asp-action="Create" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">Câu 3: Rental Book Page</div>
                        <small class="text-muted">Lập phiếu thuê & lưu 2 bảng</small>
                    </div>
                    <span class="badge bg-primary rounded-pill">5 điểm</span>
                </a>
                <a asp-controller="Reports" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">Câu 4: Report All Book</div>
                        <small class="text-muted">Báo cáo thuê theo ngày</small>
                    </div>
                    <span class="badge bg-primary rounded-pill">3 điểm</span>
                </a>
                <div class="list-group-item d-flex justify-content-between align-items-center bg-light">
                    <div>
                        <div class="fw-semibold">Bonus: UI/UX & Clean Code</div>
                        <small class="text-muted">Bootstrap 5, Responsive, EF Core</small>
                    </div>
                    <span class="badge bg-success rounded-pill">+1 điểm</span>
                </div>
            </div>
        </div>
    </div>
</div>

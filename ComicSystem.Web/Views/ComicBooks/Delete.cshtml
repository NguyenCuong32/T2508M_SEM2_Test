@model ComicSystem.Web.Models.ComicBook

@{
    ViewData["Title"] = "Xác nhận xóa Sách";
    bool hasRentals = ViewBag.HasRentals ?? false;
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Xóa Truyện</h5>
            </div>
            <div class="card-body p-4">
                @if (hasRentals)
                {
                    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-octagon-fill fs-3 me-3"></i>
                        <div>
                            <strong>Cảnh báo ràng buộc toàn vẹn dữ liệu:</strong>
                            <p class="mb-0">Truyện này đã có lượt thuê trong hệ thống. Không thể xóa để đảm bảo toàn vẹn lịch sử giao dịch!</p>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-danger fw-semibold">Bạn có chắc chắn muốn xóa cuốn truyện này khỏi hệ thống không?</p>
                }

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Mã truyện:</dt>
                    <dd class="col-sm-8 fw-bold">#@Model.ComicBookID</dd>

                    <dt class="col-sm-4 text-muted">Tên truyện:</dt>
                    <dd class="col-sm-8 fw-bold text-dark">@Model.Title</dd>

                    <dt class="col-sm-4 text-muted">Tác giả:</dt>
                    <dd class="col-sm-8">@Model.Author</dd>

                    <dt class="col-sm-4 text-muted">Giá thuê 1 ngày:</dt>
                    <dd class="col-sm-8 fw-bold text-success">@Model.PricePerDay.ToString("N0") đ</dd>
                </dl>

                <div class="d-flex justify-content-between pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    @if (!hasRentals)
                    {
                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="ComicBookID" />
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash-fill me-1"></i> Xác nhận xóa
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

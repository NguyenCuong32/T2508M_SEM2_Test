@model ComicSystem.Web.Models.ComicBook

@{
    ViewData["Title"] = "Chi tiết Sách";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-info text-white py-3">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Thông Tin Chi Tiết Sách #@Model.ComicBookID</h5>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Tên truyện:</dt>
                    <dd class="col-sm-8 fw-bold fs-5 text-primary">@Model.Title</dd>

                    <dt class="col-sm-4 text-muted">Tác giả:</dt>
                    <dd class="col-sm-8">@Model.Author</dd>

                    <dt class="col-sm-4 text-muted">Giá thuê 1 ngày:</dt>
                    <dd class="col-sm-8 fw-bold text-success">@Model.PricePerDay.ToString("N0") đ</dd>

                    <dt class="col-sm-4 text-muted">Tổng số lượt thuê:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-primary fs-6">@Model.RentalDetails.Count lượt</span>
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.ComicBookID" class="btn btn-warning me-2">
                        <i class="bi bi-pencil me-1"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.ComicBookID" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Xóa
                    </a>
                </div>
            </div>
        </div>

        @if (Model.RentalDetails.Any())
        {
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    <h6 class="card-title mb-0 fw-bold"><i class="bi bi-clock-history me-2"></i>Lịch Sử Thuê Truyện Này</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Khách hàng</th>
                                <th>Ngày thuê</th>
                                <th>Ngày trả</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rd in Model.RentalDetails)
                            {
                                <tr>
                                    <td>@(rd.Rental?.Customer?.FullName ?? "N/A")</td>
                                    <td>@rd.Rental?.RentalDate.ToString("dd/MM/yyyy")</td>
                                    <td>@rd.Rental?.ReturnDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">@rd.Quantity</td>
                                    <td class="text-center">
                                        <span class="badge @(rd.Rental?.Status == "Đang thuê" ? "bg-warning text-dark" : "bg-success")">
                                            @rd.Rental?.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

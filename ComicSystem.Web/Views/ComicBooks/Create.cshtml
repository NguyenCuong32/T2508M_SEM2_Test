@model ComicSystem.Web.Models.ComicBook

@{
    ViewData["Title"] = "Thêm Sách Mới";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Thêm Sách Truyện Mới</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" placeholder="Ví dụ: Thám tử lừng danh Conan Tập 1" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Author" class="form-label fw-semibold"></label>
                        <input asp-for="Author" class="form-control" placeholder="Ví dụ: Gosho Aoyama" />
                        <span asp-validation-for="Author" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PricePerDay" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="PricePerDay" class="form-control" type="number" step="500" min="500" placeholder="5000" />
                            <span class="input-group-text">VNĐ / ngày</span>
                        </div>
                        <span asp-validation-for="PricePerDay" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Lưu sách truyện
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

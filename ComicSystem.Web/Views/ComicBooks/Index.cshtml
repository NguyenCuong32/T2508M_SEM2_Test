@model IEnumerable<ComicSystem.Web.Models.ComicBook>

@{
    ViewData["Title"] = "Quản lý Sách Truyện";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-primary mb-1"><i class="bi bi-book me-2"></i>Quản lý Sách Truyện</h2>
        <p class="text-muted mb-0">Quản lý kho sách truyện tranh (Thêm, sửa, xóa, tìm kiếm)</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Thêm sách mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm theo tên sách hoặc tác giả..." />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary">Tìm kiếm</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="text-center" style="width: 80px;">Mã</th>
                    <th scope="col">Tên sách</th>
                    <th scope="col">Tác giả</th>
                    <th scope="col" class="text-end">Giá thuê 1 ngày</th>
                    <th scope="col" class="text-center">Số lượt thuê</th>
                    <th scope="col" class="text-center" style="width: 220px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không có truyện nào phù hợp với điều kiện tìm kiếm.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold text-secondary">#@item.ComicBookID</td>
                            <td class="fw-semibold text-dark">@item.Title</td>
                            <td><span class="badge bg-light text-dark border">@item.Author</span></td>
                            <td class="text-end fw-bold text-success">@item.PricePerDay.ToString("N0") đ</td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark">@(item.RentalDetails?.Count ?? 0) lượt</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.ComicBookID" class="btn btn-outline-warning" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.ComicBookID" class="btn btn-outline-info" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i> Chi tiết
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ComicBookID" class="btn btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i> Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

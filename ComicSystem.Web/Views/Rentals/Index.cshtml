@model IEnumerable<ComicSystem.Web.Models.Rental>

@{
    ViewData["Title"] = "Quản lý Thuê Truyện";
    var statusFilter = ViewData["StatusFilter"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-primary mb-1"><i class="bi bi-journal-check me-2"></i>Quản lý Thuê Truyện</h2>
        <p class="text-muted mb-0">Theo dõi các phiếu thuê sách, trạng thái và trả truyện</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-cart-plus-fill me-1"></i> Lập phiếu thuê mới (Câu 3)
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="statusFilter" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Đang thuê" selected="@(statusFilter == "Đang thuê")">Đang thuê</option>
                    <option value="Đã trả" selected="@(statusFilter == "Đã trả")">Đã trả</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary">Lọc</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="text-center" style="width: 80px;">Mã phiếu</th>
                    <th scope="col">Khách hàng</th>
                    <th scope="col">Truyện tranh thuê</th>
                    <th scope="col">Ngày thuê</th>
                    <th scope="col">Ngày trả</th>
                    <th scope="col" class="text-center">Số lượng</th>
                    <th scope="col" class="text-center">Trạng thái</th>
                    <th scope="col" class="text-center" style="width: 200px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không có phiếu thuê nào.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold text-secondary">#@item.RentalID</td>
                            <td>
                                <div class="fw-semibold text-dark">@(item.Customer?.FullName ?? "N/A")</div>
                                <small class="text-muted"><i class="bi bi-telephone"></i> @(item.Customer?.PhoneNumber ?? "")</small>
                            </td>
                            <td>
                                @foreach (var detail in item.RentalDetails)
                                {
                                    <div class="fw-semibold text-primary">
                                        <i class="bi bi-book me-1"></i>@(detail.ComicBook?.Title ?? "N/A")
                                        <span class="text-muted small">(@detail.PricePerDay.ToString("N0") đ/ngày)</span>
                                    </div>
                                }
                            </td>
                            <td>@item.RentalDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.ReturnDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center fw-bold">
                                @item.RentalDetails.Sum(rd => rd.Quantity)
                            </td>
                            <td class="text-center">
                                @if (item.Status == "Đang thuê")
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-hourglass-split me-1"></i>Đang thuê</span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-2 py-1"><i class="bi bi-check-circle me-1"></i>@item.Status</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.RentalID" class="btn btn-outline-info" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i> Chi tiết
                                    </a>
                                    @if (item.Status == "Đang thuê")
                                    {
                                        <form asp-action="ReturnBook" asp-route-id="@item.RentalID" method="post" class="d-inline" onsubmit="return confirm('Xác nhận khách đã trả sách?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Xác nhận trả sách">
                                                <i class="bi bi-box-arrow-in-left"></i> Trả sách
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

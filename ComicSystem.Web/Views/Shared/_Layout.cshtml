<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ComicSystem (comicsys.com)</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom site styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm border-bottom border-secondary">
            <div class="container">
                <a class="navbar-brand fw-bold text-warning d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-journal-bookmark-fill fs-4 me-2"></i> ComicSystem
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="ComicBooks" asp-action="Index">
                                <i class="bi bi-book me-1"></i> Sách truyện (Q1)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Customers" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Khách hàng (Q2)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Rentals" asp-action="Index">
                                <i class="bi bi-journal-check me-1"></i> Thuê truyện (Q3)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Reports" asp-action="Index">
                                <i class="bi bi-file-earmark-bar-graph me-1"></i> Báo cáo (Q4)
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Rentals" asp-action="Create" class="btn btn-warning btn-sm fw-bold px-3 shadow-sm">
                            <i class="bi bi-cart-plus-fill me-1"></i> Lập Phiếu Thuê
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-3 mt-auto shadow-sm">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <span class="text-muted small">
                &copy; 2026 - <strong>ComicSystem</strong> (<em>comicsys.com</em>) - FPT Aptech SET01 Exam
            </span>
            <ul class="nav list-unstyled d-flex mb-0">
                <li class="ms-3">
                    <span class="badge bg-secondary">ASP.NET Core MVC</span>
                </li>
                <li class="ms-2">
                    <span class="badge bg-primary">EF Core</span>
                </li>
                <li class="ms-2">
                    <span class="badge bg-success">SQL Server</span>
                </li>
            </ul>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

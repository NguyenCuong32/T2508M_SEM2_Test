@model ComicSystem.Web.Models.Customer

@{
    ViewData["Title"] = "Chi tiết Khách Hàng";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0 fw-bold">
                    <i class="bi bi-person-badge me-2"></i>Thông Tin Khách Hàng #@Model.CustomerID
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-md-4">
                        <small class="text-muted d-block">Họ và tên</small>
                        <span class="fs-5 fw-bold text-dark">@Model.FullName</span>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Số điện thoại</small>
                        <span class="fs-5 fw-bold text-primary">@Model.PhoneNumber</span>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Ngày đăng ký</small>
                        <span class="fs-5 fw-bold text-secondary">@Model.RegistrationDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
                <a asp-controller="Rentals" asp-action="Create" class="btn btn-success">
                    <i class="bi bi-cart-plus me-1"></i> Thuê sách mới cho khách này
                </a>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-light py-3">
                <h6 class="card-title mb-0 fw-bold"><i class="bi bi-journal-bookmark me-2"></i>Lịch Sử Thuê Truyện Của Khách Hàng</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã phiếu</th>
                            <th>Ngày thuê</th>
                            <th>Ngày trả</th>
                            <th>Truyện thuê</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Rentals.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    Khách hàng này chưa có giao dịch thuê sách nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var rental in Model.Rentals.OrderByDescending(r => r.RentalDate))
                            {
                                <tr>
                                    <td class="fw-bold">#@rental.RentalID</td>
                                    <td>@rental.RentalDate.ToString("dd/MM/yyyy")</td>
                                    <td>@rental.ReturnDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @foreach (var item in rental.RentalDetails)
                                        {
                                            <div><i class="bi bi-book me-1 text-primary"></i>@(item.ComicBook?.Title ?? "N/A")</div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @rental.RentalDetails.Sum(rd => rd.Quantity)
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(rental.Status == "Đang thuê" ? "bg-warning text-dark" : "bg-success")">
                                            @rental.Status
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Rentals" asp-action="Details" asp-route-id="@rental.RentalID" class="btn btn-sm btn-outline-info">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

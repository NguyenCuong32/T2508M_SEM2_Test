@model IEnumerable<ComicSystem.Web.Models.Customer>

@{
    ViewData["Title"] = "Quản lý Khách Hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-primary mb-1"><i class="bi bi-people me-2"></i>Quản lý Khách Hàng</h2>
        <p class="text-muted mb-0">Danh sách khách hàng đăng ký thuê truyện (Đề bài Câu 2)</p>
    </div>
    <a asp-action="Register" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Đăng ký khách hàng mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm theo họ tên hoặc số điện thoại..." />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary">Tìm kiếm</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="text-center" style="width: 80px;">Mã KH</th>
                    <th scope="col">Họ và tên</th>
                    <th scope="col">Số điện thoại</th>
                    <th scope="col">Ngày đăng ký</th>
                    <th scope="col" class="text-center">Số phiếu thuê</th>
                    <th scope="col" class="text-center" style="width: 150px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-people fs-2 d-block mb-2"></i>
                            Không tìm thấy khách hàng nào.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold text-secondary">#@item.CustomerID</td>
                            <td class="fw-semibold text-dark">
                                <i class="bi bi-person-circle me-1 text-primary"></i> @item.FullName
                            </td>
                            <td>
                                <a href="tel:@item.PhoneNumber" class="text-decoration-none">
                                    <i class="bi bi-telephone me-1 text-muted"></i>@item.PhoneNumber
                                </a>
                            </td>
                            <td>@item.RegistrationDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">
                                <span class="badge bg-primary">@(item.Rentals?.Count ?? 0) phiếu</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.CustomerID" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye"></i> Lịch sử thuê
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

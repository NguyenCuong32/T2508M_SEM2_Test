@model ComicSystemApp.DTOs.ComicBookDTO

<h2>Thêm truyện mới</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label>Tên sách:</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Tác giả:</label>
        <input asp-for="Author" class="form-control" />
        <span asp-validation-for="Author" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Giá thuê/ngày:</label>
        <input asp-for="PricePerDay" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="PricePerDay" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
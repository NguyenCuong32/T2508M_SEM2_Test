@model IEnumerable<ACMF_PRACTICE_1.Models.Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-people me-2"></i>Customers</h2>
    <a asp-action="Register" class="btn btn-success">
        <i class="bi bi-person-plus me-1"></i>Register New Customer
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Phone Number</th>
                    <th>Registration Date</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No customers yet. Register the first one!</td>
                    </tr>
                }
                @{ int i = 1; }
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td><strong>@c.FullName</strong></td>
                        <td>@c.PhoneNumber</td>
                        <td>@c.RegistrationDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@c.CustomerID" class="btn btn-sm btn-outline-info" title="View Rentals">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

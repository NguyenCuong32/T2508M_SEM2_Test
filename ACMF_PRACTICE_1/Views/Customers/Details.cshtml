@model ACMF_PRACTICE_1.Models.Customer
@{
    ViewData["Title"] = "Customer Details";
}

<div class="mb-4">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-person me-2"></i>Customer Profile</h5>
            <a asp-action="Index" class="btn btn-sm btn-light">
                <i class="bi bi-arrow-left me-1"></i>Back
            </a>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Phone Number</dt>
                <dd class="col-sm-9">@Model.PhoneNumber</dd>

                <dt class="col-sm-3">Registered</dt>
                <dd class="col-sm-9">@Model.RegistrationDate.ToString("dd/MM/yyyy")</dd>
            </dl>
        </div>
    </div>
</div>

<h5><i class="bi bi-receipt me-2"></i>Rental History</h5>

@if (!Model.Rentals.Any())
{
    <p class="text-muted">No rentals yet.</p>
}
else
{
    @foreach (var rental in Model.Rentals)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between">
                <span>
                    <strong>Rental #@rental.RentalID</strong> —
                    @rental.RentalDate.ToString("dd/MM/yyyy") → @rental.ReturnDate.ToString("dd/MM/yyyy")
                </span>
                <span class="badge @(rental.Status == "Đang thuê" ? "bg-warning text-dark" : "bg-success")">
                    @rental.Status
                </span>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Book</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-end">Price / Day</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in rental.RentalDetails)
                        {
                            <tr>
                                <td>@detail.ComicBook?.Title</td>
                                <td class="text-center">@detail.Quantity</td>
                                <td class="text-end">@detail.PricePerDay.ToString("N0") VND</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

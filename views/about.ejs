<%- include('partials/header', { title: 'Tree Shop - About Me' }) %>

<main>
  <h1 class="page-title">About Me</h1>

  <div class="main-card">
    <div class="about-card">
      <!-- Left side: avatar / illustration -->
      <div class="about-avatar" style="background-color: #f0f4f1; width: 200px; height: 200px; display: flex; align-items: center; justify-content: center; border-radius: 50%; border: 3px solid var(--primary-color);">
        <svg width="100" height="100" fill="currentColor" class="bi bi-person-fill" viewBox="0 0 16 16" style="color: var(--primary-color);">
          <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>

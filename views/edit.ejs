<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sửa cây - Tree Shop</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">
    <h1 class="page-title">Sửa cây</h1>

    <% const editRatio = tree.imageRatio || '1:1'; %>
    <% const editCssRatio = editRatio.split(':').join(' / '); %>
    <div class="edit-wrap">
      <section class="card">
        <h2>Sửa: <%= tree.treename %></h2>

        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>

        <div class="preview-frame preview-frame-small" id="previewFrame" style="aspect-ratio: <%= editCssRatio %>;">
          <% if (tree.image) { %>
            <img id="previewImg" src="<%= tree.image %>" alt="<%= tree.treename %>" onerror="this.style.display='none'; document.getElementById('previewPlaceholder').style.display='flex';" />
          <% } else { %>
            <img id="previewImg" src="" alt="" style="display:none;" />
          <% } %>
          <div id="previewPlaceholder" class="preview-placeholder" style="<%= tree.image ? 'display:none;' : '' %>">
            Chưa có ảnh xem trước
          </div>
        </div>

        <form action="/edit/<%= tree._id %>" method="POST" class="tree-form">
          <div class="form-group">
            <div class="label-row">
              <label for="treename">Tree Name</label>
              <span class="char-counter" id="treenameCounter">0/100</span>
            </div>
            <input
              type="text"
              id="treename"
              name="treename"
              maxlength="100"
              value="<%= tree.treename || '' %>"
              data-exclude-id="<%= tree._id %>"
              autocomplete="off"
            />
            <p class="name-check-msg" id="treenameCheckMsg"></p>
          </div>

          <div class="form-group">
            <div class="label-row">
              <label for="description">Description</label>
              <span class="char-counter" id="descriptionCounter">0/500</span>
            </div>
            <textarea
              id="description"
              name="description"
              rows="4"
              maxlength="500"
            ><%= tree.description || '' %></textarea>
          </div>

          <div class="form-group">
            <label for="imageDisplay">Image</label>
            <p class="field-hint">Chọn ảnh mới sẽ mở công cụ cắt ảnh theo tỉ lệ 1:1, 2:3 hoặc 3:2.</p>
            <div class="image-input-row">
              <input
                type="text"
                id="imageDisplay"
                placeholder="D:\image\phonglan.png"
                value="<%= (tree.image && !tree.image.startsWith('data:')) ? tree.image : '' %>"
              />
              <button type="button" class="btn btn-browse" id="browseBtn">Browser</button>
              <input type="file" id="fileInput" accept="image/*" hidden />
            </div>
            <div class="size-meter-row">
              <div class="size-meter">
                <div class="size-bar" id="imageSizeBar"></div>
              </div>
              <span class="size-text" id="imageSizeText">Chưa có ảnh</span>
            </div>
            <input type="hidden" id="image" name="image" value="<%= tree.image || '' %>" />
            <input type="hidden" id="imageRatio" name="imageRatio" value="<%= tree.imageRatio || '' %>" />
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a href="/" class="btn btn-browse">Hủy</a>
          </div>
        </form>
      </section>
    </div>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/crop-modal') %>

  <script src="/js/image-crop.js"></script>
  <script src="/js/char-counter.js"></script>
  <script src="/js/name-check.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tree Shop</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">
    <%- include('partials/add-tree-form') %>

    <section class="list-section">
      <div class="table-wrapper">
        <table class="tree-table">
          <thead>
            <tr>
              <th>Id</th>
              <th>Name</th>
              <th>Image</th>
              <th>Description</th>
              <th class="actions-head"></th>
            </tr>
          </thead>
          <tbody>
            <% if (trees.length === 0) { %>
              <tr>
                <td colspan="5" class="empty-state">Chưa có dữ liệu cây nào. Hãy thêm cây mới!</td>
              </tr>
            <% } else { %>
              <% trees.forEach((tree, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td title="<%= tree.treename %>"><%= tree.treename %></td>
                  <td class="image-cell">
                    <% if (tree.image) { %>
                      <% const rowCssRatio = (tree.imageRatio || '1:1').split(':').join(' / '); %>
                      <div class="thumb-frame" style="aspect-ratio: <%= rowCssRatio %>;">
                        <img class="tree-thumb" src="<%= tree.image %>" alt="<%= tree.treename %>" onerror="this.parentElement.style.display='none'" />
                      </div>
                    <% } else { %>
                      <span class="no-image">—</span>
                    <% } %>
                  </td>
                  <td title="<%= tree.description %>"><%= tree.description %></td>
                  <td class="actions-cell">
                    <a class="icon-btn icon-edit" href="/edit/<%= tree._id %>" title="Sửa" aria-label="Sửa">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    </a>
                    <form action="/delete/<%= tree._id %>" method="POST" class="delete-form">
                      <button class="icon-btn icon-delete" type="submit" title="Xóa" aria-label="Xóa" onclick="return confirm('Xóa cây này?');">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/crop-modal') %>

  <script src="/js/image-crop.js"></script>
  <script src="/js/char-counter.js"></script>
  <script src="/js/name-check.js"></script>
</body>
</html>

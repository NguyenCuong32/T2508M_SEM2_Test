<%- include('partials/header') %>

<main>
    <h1 style="text-align: center; color: #7f998c; font-style: italic; font-weight: normal; margin-bottom: 20px; font-size: 32px;">Tree Shop</h1>

    <% if (errors && errors.length > 0) { %>
        <div style="background-color: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 15px; border-radius: 4px; border: 1px solid #f5c6cb;">
            <ul style="margin-left: 20px;">
                <% errors.forEach(function(error) { %>
                    <li><%= error %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <% if (success_msg) { %>
        <div style="background-color: #d4edda; color: #155724; padding: 10px; margin-bottom: 15px; border-radius: 4px; border: 1px solid #c3e6cb;">
            <%= success_msg %>
        </div>
    <% } %>

    <div style="display: flex; gap: 40px; margin-bottom: 40px; align-items: flex-start;">
        <div style="width: 200px; height: 200px; border: 1px solid #ccc; padding: 4px;">
            <img src="/images/phonglan.png" alt="Tree Preview" style="width: 100%; height: 100%; object-fit: cover;">
        </div>

        <form action="/add" method="POST" style="flex: 1;">
            <div style="margin-bottom: 15px;">
                <label style="display: block; color: #999; font-size: 13px; margin-bottom: 5px;">Tree Name</label>
                <input type="text" name="treename" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
            </div>

            <div style="margin-bottom: 15px;">
                <label style="display: block; color: #999; font-size: 13px; margin-bottom: 5px;">Description</label>
                <textarea name="description" rows="3" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; resize: vertical;"></textarea>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; color: #999; font-size: 13px; margin-bottom: 5px;">Image</label>
                <div style="display: flex; gap: 10px;">
                    <input type="text" name="image" placeholder="D:\\image\phonglan.png" style="flex: 1; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                    <button type="button" style="background-color: #e2f0d9; border: 1px solid #bbb; padding: 0 15px; border-radius: 4px; cursor: pointer; font-size: 13px;">Browser</button>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 15px;">
                <button type="submit" style="background-color: #7f998c; color: white; border: none; padding: 8px 25px; border-radius: 4px; font-weight: bold; cursor: pointer;">Add</button>
                <a href="/reset" style="background-color: #b26666; color: white; text-decoration: none; border: none; padding: 8px 20px; border-radius: 4px; font-weight: bold; cursor: pointer; text-align: center;">Reset</a>
            </div>
        </form>
    </div>

    <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
        <thead>
            <tr style="background-color: #7f998c; color: white; font-size: 13px; text-align: left;">
                <th style="padding: 10px; font-weight: normal; width: 50px;">Id</th>
                <th style="padding: 10px; font-weight: normal; width: 120px;">Name</th>
                <th style="padding: 10px; font-weight: normal; width: 100px;">Image</th>
                <th style="padding: 10px; font-weight: normal;">Description</th>
                <th style="padding: 10px; font-weight: normal; width: 80px; text-align: center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (trees && trees.length > 0) { %>
                <% trees.forEach(function(tree, index) { %>
                    <tr style="border-bottom: 1px solid #eee; font-size: 13px; vertical-align: top;">
                        <td style="padding: 15px 10px;"><%= index + 1 %></td>
                        <td style="padding: 15px 10px;"><%= tree.treename %></td>
                        <td style="padding: 15px 10px;">
                            <img src="/images/phonglan.png" alt="tree" style="width: 50px; height: 50px; object-fit: cover;">
                        </td>
                        <td style="padding: 15px 10px; line-height: 1.5; color: #333;"><%= tree.description %></td>
                        <td style="padding: 15px 10px; text-align: center;">
                            <span style="color: #4a90e2; cursor: pointer; margin-right: 10px; font-size: 16px;">✏️</span>
                            <span style="color: #d0021b; cursor: pointer; font-size: 16px;">🗑️</span>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5" style="padding: 20px; text-align: center; color: #999; font-style: italic;">Chưa có dữ liệu cây nào trong cơ sở dữ liệu.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</main>

<%- include('partials/footer') %>
<%- include("partials/header") %>

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2 class="fw-bold text-success">
        Our Trees
    </h2>

    <div>

        <a href="/add" class="btn btn-success">
            + Add Tree
        </a>

        <a href="/reset"
            class="btn btn-danger"
            onclick="return confirm('Delete all trees?')">
            Reset
        </a>

    </div>

</div>

<% if (trees.length === 0) { %>

    <div class="alert alert-warning text-center shadow-sm">

        <h4>No trees found!</h4>

        <p class="mb-3">Start by adding your first tree.</p>

        <a href="/add" class="btn btn-success">
            Add First Tree
        </a>

    </div>

<% } else { %>

<div class="row">

    <% trees.forEach(tree => { %>

        <div class="col-lg-4 col-md-6 mb-4">

            <div class="card shadow tree-card h-100">

                <img src="<%= tree.image %>"
                     class="card-img-top tree-image"
                     alt="<%= tree.treename %>">

                <div class="card-body">

                    <h4 class="text-success">
                        <%= tree.treename %>
                    </h4>

                    <p class="text-muted">
                        <%= tree.description %>
                    </p>

                </div>

            </div>

        </div>

    <% }) %>

</div>

<% if(totalPages > 1){ %>

<nav class="mt-4">

    <ul class="pagination justify-content-center">

        <% for(let i = 1; i <= totalPages; i++){ %>

            <li class="page-item <%= currentPage === i ? 'active' : '' %>">

                <a class="page-link"
                   href="/?page=<%= i %>">

                    <%= i %>

                </a>

            </li>

        <% } %>

    </ul>

</nav>

<% } %>

<% } %>

<%- include("partials/footer") %>
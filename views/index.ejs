<%- include('partials/header') %>

<h1 class="page-title">Tree Shop</h1>

<% if (errors && errors.length > 0) { %>
  <div class="alert alert-danger">
    <% errors.forEach(function(error) { %>
      <div><%= error %></div>
    <% }) %>
  </div>
<% } %>

<div class="content-wrapper">
  <div class="preview-section">
    <img id="previewImg" class="preview-image" src="/images/default.png" alt="Tree Preview">
  </div>

  <div class="form-section">
    <form action="/add" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label for="treename">Tree Name</label>
        <input type="text" id="treename" name="treename" class="form-control" placeholder="Phong lan">
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" class="form-control" placeholder="Nhắc đến ý nghĩa của hoa phong lan..."></textarea>
      </div>

      <div class="form-group">
        <label>Image</label>
        <div class="image-input-group">
          <input type="text" id="imageText" name="imageText" placeholder="D:\image\phonglan.png" readonly class="form-control">
          <input type="file" id="imageFile" name="imageFile" style="display: none;" accept="image/*">
          <button type="button" id="browseBtn" class="btn-browser">Browser</button>
        </div>
      </div>

      <div class="buttons-row">
        <button type="submit" class="btn btn-add">Add</button>
        <button type="button" class="btn btn-reset" onclick="if(confirm('Clean all trees from the database?')) { document.getElementById('resetForm').submit(); }">Reset</button>
      </div>
    </form>
  </div>
</div>

<form id="resetForm" action="/reset" method="POST" style="display: none;"></form>

<div class="table-section">
  <table>
    <thead>
      <tr>
        <th style="width: 50px;">Id</th>
        <th style="width: 150px;">Name</th>
        <th style="width: 100px;">Image</th>
        <th>Description</th>
        <th style="width: 80px;"></th>
      </tr>
    </thead>
    <tbody>
      <% if (trees && trees.length > 0) { %>
        <% trees.forEach(function(tree, index) { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= tree.treename %></td>
            <td>
              <img src="<%= tree.image || '/images/default.png' %>" class="table-thumbnail" alt="<%= tree.treename %>">
            </td>
            <td><%= tree.description %></td>
            <td class="action-links">
              <a href="/edit/<%= tree.id %>" class="action-icon icon-edit" title="Edit">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                  <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
              </a>
              <a href="/delete/<%= tree.id %>" class="action-icon icon-delete" title="Delete" onclick="return confirm('Are you sure you want to delete this tree?')">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  <line x1="10" y1="11" x2="10" y2="17"></line>
                  <line x1="14" y1="11" x2="14" y2="17"></line>
                </svg>
              </a>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="5" style="text-align: center; color: #888;">No trees found.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<script>
  document.getElementById('browseBtn').addEventListener('click', function() {
    document.getElementById('imageFile').click();
  });

  document.getElementById('imageFile').addEventListener('change', function() {
    if (this.files && this.files[0]) {
      document.getElementById('imageText').value = this.files[0].name;
      var reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('previewImg').src = e.target.result;
      };
      reader.readAsDataURL(this.files[0]);
    }
  });
</script>

<%- include('partials/footer') %>

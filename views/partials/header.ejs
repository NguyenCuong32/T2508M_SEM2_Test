<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tree Shop</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }
        body {
            background-color: #ffffff;
            padding: 20px;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
        }
        /* Style cho Header */
        .header-banner {
            background-color: #8fa89b;
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 2px;
            margin-bottom: 20px;
        }
        .header-banner a {
            color: white;
            text-decoration: none;
            font-size: 18px;
            font-style: italic;
        }
        .header-banner .nav-links a {
            font-style: normal;
            font-size: 14px;
            margin-left: 20px;
        }
        .header-banner a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="header-banner">
            <a href="/">Tree Shop</a>
            <div class="nav-links">
                <a href="/">TreeShop</a>
                <a href="/about">About me</a>
            </div>
        </header>
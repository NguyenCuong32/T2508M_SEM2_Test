<Window x:Class="ProductViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductViewer"
        mc:Ignorable="d"
        Title="Apex Tech Catalog" 
        Height="580" 
        Width="920"
        WindowStartupLocation="CenterScreen" 
        AllowsTransparency="True" 
        WindowStyle="None" 
        Background="Transparent">
    
    <Window.Resources>
        <!-- Custom ListBoxItem Style for glassmorphic cards -->
        <Style x:Key="ProductCardStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" 
                                CornerRadius="12" 
                                Background="#10FFFFFF" 
                                BorderBrush="#20FFFFFF" 
                                BorderThickness="1.2" 
                                SnapsToDevicePixels="true" 
                                Padding="14,12,14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#20FFFFFF" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#8B5CF6" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#258B5CF6" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#A78BFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ScrollViewer / ScrollBar styling for modern slim look -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Visibility="Collapsed"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Visibility="Collapsed"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#40FFFFFF" BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border CornerRadius="3" Background="{TemplateBinding Background}" SnapsToDevicePixels="true"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer shadow container -->
    <Border CornerRadius="16" Margin="15" Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#000000" Opacity="0.65"/>
        </Border.Effect>
        
        <!-- Main Application Window Wrapper -->
        <Border CornerRadius="16" BorderBrush="#30818CF8" BorderThickness="1.5" ClipToBounds="True">
            <!-- Background Gradient -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B0F19" Offset="0.0"/>
                    <GradientStop Color="#141829" Offset="0.5"/>
                    <GradientStop Color="#1C1430" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />  <!-- Custom Title Bar -->
                    <RowDefinition Height="*" />   <!-- Application Body -->
                </Grid.RowDefinitions>

                <!-- 1. CUSTOM TITLE BAR -->
                <Grid Grid.Row="0" Background="#0E1220">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <TextBlock Text="⚡" FontSize="18" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="APEX GADGET CATALOG" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Drag Surface -->
                    <Grid Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

                    <!-- Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Minimize Button -->
                        <Button Content="─" Width="48" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" Click="MinimizeButton_Click" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter Property="Background" Value="#15FFFFFF"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Close Button -->
                        <Button Content="✕" Width="48" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" Click="CloseButton_Click" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter Property="Background" Value="#EF4444"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. APPLICATION BODY -->
                <Grid Grid.Row="1" Margin="20,15,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" /> <!-- Left List View -->
                        <ColumnDefinition Width="Auto" /> <!-- Splitter -->
                        <ColumnDefinition Width="*" />   <!-- Right Detailed View -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SIDE: Catalog & Search -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Search Box -->
                            <RowDefinition Height="*"/>    <!-- List Box -->
                        </Grid.RowDefinitions>

                        <!-- Premium Search Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Border CornerRadius="8" Background="#15FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1.2">
                                <Grid Margin="12,8,12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" FontSize="14" Foreground="#9CA3AF" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="SearchTextBox" 
                                             Grid.Column="1" 
                                             Background="Transparent" 
                                             BorderThickness="0" 
                                             Foreground="White" 
                                             CaretBrush="White" 
                                             FontSize="13" 
                                             VerticalAlignment="Center"
                                             TextChanged="SearchTextBox_TextChanged"/>
                                    <TextBlock Text="Search tech products..." 
                                               Grid.Column="1" 
                                               Foreground="#55FFFFFF" 
                                               FontSize="13" 
                                               IsHitTestVisible="False" 
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Text.IsEmpty, ElementName=SearchTextBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Product ListBox -->
                        <ListBox x:Name="ProductListBox" 
                                 Grid.Row="1"
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ProductCardStyle}"
                                 SelectionChanged="ProductListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon Circle Background with dynamic colors -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#158B5CF6" BorderBrush="#358B5CF6" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Icon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Product Meta -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductName}" Foreground="#F3F4F6" FontSize="14" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Category}" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding FormattedPrice}" Foreground="#10B981" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Splitter Bar -->
                    <Border Grid.Column="1" Width="1" Background="#20FFFFFF" Margin="20,0,20,0" VerticalAlignment="Stretch"/>

                    <!-- RIGHT SIDE: Detailed View -->
                    <Grid Grid.Column="2">
                        <!-- Welcome / Placeholder Panel (Visible when nothing is selected) -->
                        <Grid x:Name="WelcomePanel" Visibility="Visible">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="80" Height="80" CornerRadius="40" Background="#08FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,18">
                                    <TextBlock Text="💎" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="SELECT A DEVICE" Foreground="#F3F4F6" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Choose a product from the list to view full specifications," Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Text="live rates, and detailed inventory data." Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Active Product Details Panel (Visible when an item is selected) -->
                        <Grid x:Name="DetailsPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Main Header -->
                                <RowDefinition Height="*" />    <!-- Content & Specs -->
                                <RowDefinition Height="Auto" /> <!-- Footer CTA -->
                            </Grid.RowDefinitions>

                            <!-- Header Section -->
                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Width="68" Height="68" CornerRadius="16" Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" Margin="0,0,18,0">
                                    <TextBlock x:Name="DetailIcon" Text="📱" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <!-- Badges -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border CornerRadius="4" Background="#303B82F6" BorderBrush="#603B82F6" BorderThickness="0.8" Padding="6,2,6,2" Margin="0,0,6,0">
                                            <TextBlock x:Name="DetailCategory" Text="Category" Foreground="#60A5FA" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border CornerRadius="4" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="0.8" Padding="6,2,6,2">
                                            <TextBlock x:Name="DetailBrand" Text="Apple Inc." Foreground="#9CA3AF" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- Title -->
                                    <TextBlock x:Name="DetailName" Text="Product Name" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Scrollable Content -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Stats & Rating Bar -->
                                    <Border CornerRadius="10" Background="#08FFFFFF" Padding="14" Margin="0,0,0,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Price Stat -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="UNIT PRICE" Foreground="#9CA3AF" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="DetailPrice" Text="$1,000.99" Foreground="#10B981" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Rating Stat -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="CUSTOMER RATING" Foreground="#9CA3AF" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="DetailRating" Text="⭐⭐⭐⭐★ (4.8)" Foreground="#F59E0B" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Description Heading -->
                                    <TextBlock Text="OVERVIEW" Foreground="#A78BFA" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                    <!-- Description Text -->
                                    <TextBlock x:Name="DetailDescription" 
                                               Text="Lorem ipsum dolor sit amet..." 
                                               Foreground="#D1D5DB" 
                                               FontSize="13.5" 
                                               TextWrapping="Wrap" 
                                               LineHeight="20" 
                                               Margin="0,0,0,18"/>

                                    <!-- Tech Specs Panel -->
                                    <TextBlock Text="SPECIFICATIONS" Foreground="#A78BFA" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                                    <Border CornerRadius="10" BorderBrush="#15FFFFFF" BorderThickness="1" Background="#05FFFFFF" Padding="14">
                                        <StackPanel>
                                            <!-- Spec 1 -->
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Product ID" Foreground="#9CA3AF" FontSize="12"/>
                                                <TextBlock x:Name="DetailId" Text="1" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <!-- Spec 2 -->
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Availability" Foreground="#9CA3AF" FontSize="12"/>
                                                <TextBlock Text="In Stock (Immediate)" Foreground="#10B981" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <!-- Spec 3 -->
                                            <Grid>
                                                <TextBlock Text="Warranty" Foreground="#9CA3AF" FontSize="12"/>
                                                <TextBlock Text="1 Year Apple Warranty" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- CTA Button Section -->
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Button x:Name="ActionBtn" Content="ADD TO INVENTORY" Height="42" Foreground="White" FontSize="13" FontWeight="Bold" Cursor="Hand" Click="ActionBtn_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="BtnBorder" CornerRadius="8" Background="#8B5CF6" BorderBrush="#A78BFA" BorderThickness="0.8" SnapsToDevicePixels="true">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#A78BFA"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="true">
                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#7C3AED"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
